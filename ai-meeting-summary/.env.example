# === Required ===
# Your MeetStream API key. Get one at https://app.meetstream.ai
# Sent as `Authorization: Token <key>` (literally "Token", not "Bearer").
MEETSTREAM_API_KEY=

# === Pick ONE of these two ===
# A bot that already ran. Set this to summarise a past meeting without
# creating anything. Takes priority over MEETING_LINK.
BOT_ID=

# A live meeting link (Google Meet / Zoom / Microsoft Teams). Set this to
# send a new bot in, wait for the call to finish, then summarise it.
MEETING_LINK=

# === Bot options (only used when creating a bot) ===
# Display name the bot shows in the meeting.
BOT_NAME=MeetStream Summary Bot

# Language passed to the post-call transcript provider.
TRANSCRIPT_LANGUAGE=en

# How long MeetStream keeps this meeting's media and derived data.
RETENTION_HOURS=72

# automatic_leave timeouts, in seconds.
# Note: in_call_recording_timeout has a hard API minimum of 600.
WAITING_ROOM_TIMEOUT=600
EVERYONE_LEFT_TIMEOUT=600
IN_CALL_RECORDING_TIMEOUT=14400

# Optional: an Idempotency-Key UUID so a retried create_bot cannot double-book
# a bot. A replay comes back as HTTP 507, which this template treats as success.
IDEMPOTENCY_KEY=

# === Waiting for the meeting to end ===
# GET /bots/{id}/status is polled until the bot reaches a terminal status.
STATUS_POLL_INTERVAL_MS=15000
STATUS_POLL_MAX_ATTEMPTS=240

# === Waiting for the summary ===
# GET /bots/{id}/summary answers HTTP 202 while the summary is generating.
SUMMARY_POLL_INTERVAL_MS=10000
SUMMARY_POLL_MAX_ATTEMPTS=30

# === Output ===
# Where the raw JSON response is written.
OUTPUT_DIR=./output

# Set to true to print every field in the response, including the echoed
# request payload and the raw status timeline.
SHOW_ALL_FIELDS=false

# === HTTP behaviour ===
REQUEST_TIMEOUT_MS=30000
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1000

# Override only if you are pointed at a non-production MeetStream environment.
# MEETSTREAM_BASE_URL=https://api.meetstream.ai/api/v1
