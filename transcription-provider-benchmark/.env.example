# Transcription Provider Benchmark

# Your MeetStream API key (from https://app.meetstream.ai)
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# A meeting both benchmark bots can join (Zoom, Google Meet or Microsoft Teams).
# Keep everyone else muted while the clip plays.
MEETING_LINK=https://meet.google.com/xxx-xxxx-xxx

# Free ngrok auth token (from https://dashboard.ngrok.com/get-started/your-authtoken).
# The speaker bot connects back to this machine through it to receive the clip.
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Local port for the speaker bot's control WebSocket (default: 3000)
PORT=3000
