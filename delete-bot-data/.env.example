# ---------------------------------------------
#  delete-bot-data   (DESTRUCTIVE TEMPLATE)
# ---------------------------------------------

# Required for `inspect` and `delete`, not needed for `listen`.
# Your MeetStream API key from https://app.meetstream.ai
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# Optional. Default target for `inspect` and `delete`.
# You can also pass the id as an argument:
#   node index.js delete bot_abc123
BOT_ID=

# Optional. Port for the webhook listener (`node index.js listen`).
PORT=3000

# Optional. Only change this if you are pointing at a non-production API.
# MEETSTREAM_API_BASE_URL=https://api.meetstream.ai/api/v1
