# Copy to .env and fill in. .env is gitignored; never commit a real key.

# --- MeetStream API (only needed when you fetch a timeline with --bot-id) ---
# Create a key at https://app.meetstream.ai/api-keys
MEETSTREAM_API_KEY=
MEETSTREAM_BASE_URL=https://api.meetstream.ai/api/v1

# --- Byte-offset -> seconds conversion ---
# get_speaker_timeline returns byte offsets into the recorded audio, not seconds.
# Talk-time SHARES and TURN COUNTS are exact without these; absolute SECONDS are
# derived from them, so a wrong value here scales every duration.
# Defaults match MeetStream's raw stream: signed 16-bit PCM, 48 kHz, mono
# (48000 * 2 * 1 = 96000 bytes per second).
TALK_TIME_SAMPLE_RATE=48000
TALK_TIME_SAMPLE_WIDTH=2
TALK_TIME_CHANNELS=1

# --- Turn detection ---
# A speaker's consecutive timeline chunks are merged into one turn while the gap
# between them stays under this many seconds. Raw timelines chunk every ~250 ms,
# so 0 would report thousands of "turns" per speaker.
TALK_TIME_TURN_GAP_SECONDS=1.0

# Labels the API uses for audio it could not attribute to a participant.
# Comma-separated. Reported separately instead of counted as a speaker.
TALK_TIME_UNATTRIBUTED_LABELS=NoSpeaker,Unknown

# --- Output ---
# Where the JSON report is written when --json-out is not passed.
TALK_TIME_OUTPUT=talk-time.json
