# Copy to .env and fill in. .env is gitignored - never commit a real key.

# Required. Create at https://app.meetstream.ai/api-keys
MEETSTREAM_API_KEY=ms_your_key_here

# Required for `chat-responder run`: the bot already sitting in the meeting.
# `chat-responder join <meeting-link>` prints a bot id you can paste here.
MEETSTREAM_BOT_ID=

# Optional overrides
MEETSTREAM_BASE_URL=https://api.meetstream.ai/api/v1

# Display name of our bot in the meeting. Chat lines from this sender are
# ignored so the bot never answers itself.
BOT_NAME=Meeting Assistant

# Agenda served by !agenda. Relative paths resolve against the working directory.
AGENDA_PATH=agenda.md

# Chat poll interval in seconds. Lower = faster replies and more API calls:
# one small GET per bot per interval. Raise it if you run many bots.
POLL_INTERVAL_SECONDS=5

# Abuse limits - anyone in the meeting can type in the chat.
SENDER_COOLDOWN_SECONDS=5
MAX_REPLIES_PER_MINUTE=12

# Safety caps
MAX_MESSAGE_CHARS=2000
MAX_AGENDA_BYTES=8192
REQUEST_TIMEOUT_SECONDS=10

# DEBUG logs raw chat payloads. Keep at INFO outside local debugging.
LOG_LEVEL=INFO
