# Copy to .env and fill in. .env is gitignored; .env.example must never hold a real secret.

# --- MeetStream ---------------------------------------------------------------
# From https://app.meetstream.ai -> API keys
MEETSTREAM_API_KEY=
MEETSTREAM_BASE_URL=https://api.meetstream.ai/api/v1

# --- Webhook server -----------------------------------------------------------
# Public HTTPS origin the bot posts events to. Localhost will never receive
# anything: run `ngrok http 3000` and paste the https URL here. No trailing slash.
PUBLIC_URL=
PORT=3000

# Random secret embedded in the webhook path. Per-bot callbacks are UNSIGNED, so
# this unguessable path is what keeps the route from being open to the world.
# Generate one with:  openssl rand -hex 32
WEBHOOK_PATH_TOKEN=

# HMAC secret for a workspace-level webhook endpoint. Leave BLANK for the per-bot
# callback_url flow this CLI uses — those deliveries carry no signature, and
# setting this would reject every one of them. Set it only when you point a
# workspace endpoint at this server. See docs/webhook-security.md.
# When set, every delivery must carry X-MeetStream-Signature: sha256=<hex HMAC of
# the raw body> and X-MeetStream-Timestamp (ISO-8601, within the window below).
WEBHOOK_SIGNING_SECRET=
WEBHOOK_SIGNATURE_HEADER=x-meetstream-signature
WEBHOOK_TIMESTAMP_HEADER=x-meetstream-timestamp
WEBHOOK_TOLERANCE_SECONDS=300

# --- LLM ----------------------------------------------------------------------
# anthropic | fake   ("fake" returns a canned brief: useful before you have a key)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# --- Transcription ------------------------------------------------------------
# deepgram | assemblyai | meetstream
# "meetstream" is the in-house post-call engine and needs no external key — keep
# it unless you have added a deepgram / assemblyai key to your MeetStream account
# at https://app.meetstream.ai. A provider without a key fails at the END of the
# meeting (transcription.failed), when the recording is already over.
TRANSCRIPT_PROVIDER=meetstream
TRANSCRIPT_LANGUAGE=en

# --- Output -------------------------------------------------------------------
BOT_NAME=Notetaker
BRIEF_DIR=./briefs
LOG_LEVEL=info
