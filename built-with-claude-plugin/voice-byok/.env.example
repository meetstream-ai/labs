# MeetStream voice agent (MIA pipeline mode) - copy to .env and fill in.

# --- MeetStream ---------------------------------------------------------
# Create at https://app.meetstream.ai/api-keys
MEETSTREAM_API_KEY=ms_xxxxxxxxxxxxxxxx
MEETSTREAM_BASE_URL=https://api.meetstream.ai/api/v1

# The meeting the bot joins. Can also be passed as --meeting-link.
MEETING_LINK=https://meet.google.com/abc-defg-hij
BOT_NAME=Meeting Assistant
AGENT_NAME=Meeting Assistant

# --- Bring your own provider keys ---------------------------------------
# MeetStream runs the MIA bridge and reads these from the provider keys
# registered on your MeetStream account (app.meetstream.ai -> provider keys).
# They are kept here so this app can confirm you hold all three before it
# builds an agent that depends on them; they are not sent in the API payload.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxx
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxx

# --- LLM (OpenAI) -------------------------------------------------------
OPENAI_MODEL=gpt-4.1
LLM_TEMPERATURE=0.7

# --- Speech to text (Deepgram) ------------------------------------------
DEEPGRAM_MODEL=nova-3
TRANSCRIBE_LANGUAGE=en
# Comma separated. Product names, people, jargon - fixes most mishearings.
TRANSCRIBE_BOOSTWORDS=MeetStream,MIA,Deepgram,ElevenLabs

# --- Voice (ElevenLabs) -------------------------------------------------
# Voice id from https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_SPEED=1.0

# --- Conversation behaviour ---------------------------------------------
AGENT_SYSTEM_PROMPT=You are a friendly meeting assistant on a live call. Answer questions out loud, briefly and warmly - two or three sentences unless asked for more. If you do not know something that was said in this meeting, say so instead of guessing.
AGENT_FIRST_MESSAGE=Hi everyone, I'm an AI meeting assistant. Say "hey assistant" and I'll answer out loud.
ENABLE_INTERRUPTIONS=true
USER_AWAY_TIMEOUT=30

# Wake word keeps the agent quiet until it is addressed. Recommended on
# real calls; set false for an always-on agent.
WAKE_WORD_ENABLED=true
WAKE_WORDS=hey assistant,ok assistant,assistant
WAKE_WORD_TIMEOUT=30
