# Copy to .env and fill in. Never commit .env.

# --- Required to send a bot (not needed to run the server or the demo) ---

# API key from https://app.meetstream.ai/api-keys
MEETSTREAM_API_KEY=ms_xxxxxxxxxxxxxxxxxxxxx

# Public HTTPS URL that forwards to this local server. MeetStream will not
# deliver to http:// or to localhost, so run a tunnel and paste its URL here:
#   cloudflared tunnel --url http://127.0.0.1:8080
#   ngrok http 8080
PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com

# --- Optional ---

# Name the bot shows under inside the meeting.
BOT_NAME=Live Captions

# Where the local server listens. Keep the host on loopback: the tunnel is the
# only thing that should be reachable from outside.
CAPTIONS_HOST=127.0.0.1
CAPTIONS_PORT=8080

# If you set a webhook secret in the MeetStream dashboard, put it here and
# signed deliveries will be verified (and rejected on mismatch).
MEETSTREAM_WEBHOOK_SECRET=

# How long MeetStream keeps the recording. Captions are streamed live, so this
# only covers the stored audio.
RETENTION_HOURS=24

# Set to 0/false to disable ANSI colour in the terminal output.
CAPTIONS_COLOR=1

# MEETSTREAM_BASE_URL=https://api.meetstream.ai/api/v1
