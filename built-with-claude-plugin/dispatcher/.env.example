# Copy to .env and fill in. .env is gitignored - never commit a real key.

# Required (not needed for --dry-run). Create one at https://app.meetstream.ai/api-keys
MEETSTREAM_API_KEY=

# Optional - defaults shown.
MEETSTREAM_BASE_URL=https://api.meetstream.ai/api/v1

# Bot display name inside the meeting. A line in the links file can override it
# per meeting with "<url>,<bot name>".
MEETSTREAM_BOT_NAME=MeetStream Notetaker

# HTTPS endpoint for bot lifecycle webhooks. Leave blank to poll instead.
MEETSTREAM_CALLBACK_URL=

# Post-call transcript: none | meetstream | deepgram
# deepgram needs a Deepgram key configured on your MeetStream account.
MEETSTREAM_TRANSCRIPT_PROVIDER=none
MEETSTREAM_TRANSCRIPT_LANGUAGE=en

# How long MeetStream keeps the recording, in hours. Blank uses the account
# default (720h / 30 days). A shorter window costs less to store.
MEETSTREAM_RETENTION_HOURS=

# Dispatch behaviour.
MEETSTREAM_CONCURRENCY=4
MEETSTREAM_MAX_RETRIES=4
MEETSTREAM_BACKOFF_BASE=1.0
MEETSTREAM_MAX_BACKOFF=60
MEETSTREAM_REQUEST_TIMEOUT=30
