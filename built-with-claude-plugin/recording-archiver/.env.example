# Copy to .env and fill in. .env is gitignored; never commit a real key.

# Required. Create one at https://app.meetstream.ai/api-keys
MEETSTREAM_API_KEY=ms_your_key_here

# API base URL. Only change this if you are pointed at a non-production stack.
MEETSTREAM_BASE_URL=https://api.meetstream.ai/api/v1

# Where recordings land. Relative paths resolve against the current directory.
ARCHIVE_DIR=./archive

# Archive the mixed video file when the bot recorded one.
# This does NOT make bots record video - that is `video_required` at bot creation.
ARCHIVE_INCLUDE_VIDEO=true

# Archive per-participant audio tracks when they exist.
# They only exist if the bot was created with `audio_separate_streams: true`
# (Google Meet and Zoom only - Microsoft Teams does not support it).
ARCHIVE_INCLUDE_PARTICIPANT_AUDIO=true

# Seconds between sweeps when running with --watch.
ARCHIVE_POLL_INTERVAL_SECONDS=300

# Per-request timeout in seconds, for both API calls and media downloads.
ARCHIVE_REQUEST_TIMEOUT_SECONDS=60

# Safety cap on pages walked when listing bots in one sweep.
ARCHIVE_MAX_LIST_PAGES=20
