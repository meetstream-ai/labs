# ─────────────────────────────────────────────────────────────
#  MeetStream
# ─────────────────────────────────────────────────────────────

# Required. Create one at https://app.meetstream.ai under API Keys.
# Sent as `Authorization: Token <key>` - the literal word Token, not Bearer.
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# The meeting the bot should join (Zoom, Google Meet or Microsoft Teams).
# You can also pass it as: node index.js --meeting "<url>"
MEETING_LINK=https://meet.google.com/xxx-xxxx-xxx

BOT_NAME=Notetaker

# Post-call transcription provider:
#   deepgram | assemblyai | sarvam | jigsawstack | meetstream
# Never a *_streaming provider - those never produce a post-call transcript.
TRANSCRIPT_PROVIDER=meetstream
TRANSCRIPT_LANGUAGE=en

# ─────────────────────────────────────────────────────────────
#  Webhook (live mode only)
# ─────────────────────────────────────────────────────────────

# Public HTTPS base URL MeetStream can POST to. callback_url becomes ${PUBLIC_BASE_URL}/webhook.
# Dev: `ngrok http 3000` or `cloudflared tunnel --url http://localhost:3000`
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app
PORT=3000

TRANSCRIPT_POLL_ATTEMPTS=20
TRANSCRIPT_POLL_INTERVAL_MS=5000

# ─────────────────────────────────────────────────────────────
#  LLM - REQUIRED for this template
# ─────────────────────────────────────────────────────────────

# Pick a provider explicitly, or leave LLM_PROVIDER unset and whichever key
# is present will be used.
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Cap on how much transcript is sent to the model (roughly 4 chars per token).
LLM_MAX_TRANSCRIPT_CHARS=60000
LLM_MAX_TOKENS=2500

# ─────────────────────────────────────────────────────────────
#  Output
# ─────────────────────────────────────────────────────────────

# Writes action-items-<transcript_id>.json and .md here.
OUTPUT_DIR=output

# The date relative phrases like "by Friday" are resolved against.
# Defaults to today. Set it when replaying an older meeting.
# MEETING_DATE=2026-08-20

# Also print the Markdown report to stdout.
PRINT_MARKDOWN=true
