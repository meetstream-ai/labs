# ---------------------------------------------
#  idempotency-and-dedup
# ---------------------------------------------

# Required (except for --explain).
# Your MeetStream API key from https://app.meetstream.ai
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# Required. The meeting the demo bots join.
MEETING_LINK=https://meet.google.com/xxx-xxxx-xxx

# Optional but recommended. A SECOND, DIFFERENT meeting link.
# Reusing one deduplication_key across two different meetings is what
# produces the HTTP 409 conflict. Without this the 409 case is skipped.
MEETING_LINK_ALT=

# Optional. Only change this if you are pointing at a non-production API.
# MEETSTREAM_API_BASE_URL=https://api.meetstream.ai/api/v1
