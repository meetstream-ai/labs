# === Required ===

# Your MeetStream API key. Sent as `Authorization: Token <key>`.
# Get one at https://app.meetstream.ai
MEETSTREAM_API_KEY=your_api_key_here

# The meeting the bot should join (Google Meet, Zoom, or Microsoft Teams link).
MEETING_LINK=https://meet.google.com/abc-defg-hij

# === Webhooks (optional but recommended) ===

# Public HTTPS base URL that MeetStream can reach. The bot's callback_url
# becomes "<PUBLIC_WEBHOOK_URL>/webhook".
# Get one for local dev with: ngrok http 3000
# Leave blank to run in poll-only mode (no webhook server is started).
PUBLIC_WEBHOOK_URL=

# Local port the webhook server listens on.
PORT=3000

# === Optional ===

# Display name the bot uses inside the meeting.
BOT_NAME=MeetStream Participant Recorder

# Where downloaded per-participant audio is written.
OUTPUT_DIR=./recordings

# Request separate per-participant audio streams on create_bot.
# Set to false if your account rejects the flag with an HTTP 400.
AUDIO_SEPARATE_STREAMS=true

# Seconds the bot waits after everyone else leaves before it leaves too.
EVERYONE_LEFT_TIMEOUT=60

# Phase 1: waiting for the meeting to end.
# 240 attempts x 15s = up to 60 minutes.
MEETING_POLL_MAX_ATTEMPTS=240
MEETING_POLL_INTERVAL_MS=15000

# Phase 2: polling get_audio_streams while it answers HTTP 202.
# THIS CAP MATTERS: a streaming-only transcription provider makes the endpoint
# return 202 forever, so an uncapped loop would never exit.
# 40 attempts x 15s = 10 minutes.
STREAMS_POLL_MAX_ATTEMPTS=40
STREAMS_POLL_INTERVAL_MS=15000

# HTTP behaviour
REQUEST_TIMEOUT_MS=30000
MAX_RETRIES=4

# One of: silent, error, warn, info, debug
LOG_LEVEL=info
