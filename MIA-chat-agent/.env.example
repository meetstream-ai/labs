# Copy this file to .env, then replace the placeholder values.

# MeetStream API key (sent as "Authorization: Token <key>")
MEETSTREAM_API_KEY=your_meetstream_key_here
# ID of the saved Hosted Agent (MeetStream Dashboard > Agents)
MEETSTREAM_AGENT_CONFIG_ID=your_agent_config_id_here
# Full https:// Zoom, Google Meet or Microsoft Teams meeting link the bot joins
MEETING_LINK=your_meeting_link_here
# ngrok authtoken, used to open a temporary public webhook tunnel (not needed when CALLBACK_URL is set)
NGROK_AUTHTOKEN=your_ngrok_token_here

# Optional settings
# Local port for the webhook listener (default 3000)
# PORT=3000
# Diagnostic mode: respond to every final transcript without a wake word (default false)
# BYPASS_WAKE_WORD=false
# Use an existing public https:// endpoint instead of the automatic ngrok tunnel
# CALLBACK_URL=https://your-domain.example/webhooks/meetstream
