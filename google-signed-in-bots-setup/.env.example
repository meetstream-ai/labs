# ─────────────────────────────────────────────
#  MeetStream - Google Signed-In Bots setup
# ─────────────────────────────────────────────

# Required. Your MeetStream API key (https://app.meetstream.ai).
# Sent as `Authorization: Token <key>` - the literal word "Token", not "Bearer".
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# Optional. Override the API base URL (defaults to https://api.meetstream.ai/api/v1).
# MEETSTREAM_BASE_URL=https://api.meetstream.ai/api/v1


# ── Certificate generation (node index.js gen-cert) ────────────────────────────

# Where key.pem and cert.pem are written. Keep this directory out of git.
CERT_DIR=./certs

# Optional OpenSSL subject. Omit to be prompted interactively by openssl.
# CERT_SUBJECT=/CN=yourdomain.com/O=Your Company/C=US

# Certificate validity in days (the docs use 3650 = 10 years).
CERT_DAYS=3650


# ── Domain registration (node index.js register-domain) ────────────────────────
# Body fields for POST /google-login-domains, per the API reference:
#   user_id (required), name (required), login_mode (optional)

GOOGLE_DOMAIN_USER_ID=your_user_id
GOOGLE_DOMAIN_NAME=Acme-SSO

# "always" or "if_required". Omit to accept the API default.
# GOOGLE_LOGIN_MODE=always


# ── Sending a signed-in bot (node index.js verify / create-bot) ────────────────

# The Google Workspace domain you configured under
# Integrations -> Google Signed-In Bots. Goes into google_meet.google_login_domain.
GOOGLE_LOGIN_DOMAIN=yourdomain.com

# Optional. Pin a specific bot account. Must be a login registered under the
# domain above. Omit to let MeetStream pick one round-robin.
SIGN_IN_EMAIL=bot@yourdomain.com

# true = fail rather than fall back to a different login if SIGN_IN_EMAIL
# cannot be used.
STRICT_EMAIL=false

# The Google Meet link the bot should join.
MEETING_LINK=https://meet.google.com/xxx-xxxx-xxx

# Display name in the request. Note: for a signed-in bot Google Meet shows the
# Google account's own name and avatar, not this value.
BOT_NAME=MeetStream Signed-In Bot

# Record video as well as audio.
VIDEO_REQUIRED=false

# Seconds the bot waits in the lobby before giving up. Google Meet range: 60-600
# (default 600). An invited signed-in bot should never need this.
# WAITING_ROOM_TIMEOUT=300

# Optional per-bot webhook URL for lifecycle events.
# CALLBACK_URL=https://your-app.example.com/meetstream/webhook
