# ─────────────────────────────────────────────────────────────
#  MeetStream Labs: Send Chat Message
#  Copy this file to .env and fill it in.
# ─────────────────────────────────────────────────────────────

# Required. MeetStream dashboard -> API Keys.
# https://app.meetstream.ai
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# ─────────────────────────────────────────────────────────────
#  Optional
# ─────────────────────────────────────────────────────────────

# Default display name when this CLI creates a bot (--meeting-link mode).
# Override per run with --bot-name.
# BOT_NAME=MeetStream Labs Announcer

# How long to wait for a bot to reach the meeting before giving up.
# Override per run with --wait-timeout.
# WAIT_TIMEOUT_SECONDS=600

# API base URL. Only change this if MeetStream gave you a different one.
# MEETSTREAM_BASE_URL=https://api.meetstream.ai/api/v1

# Set to any value to disable ANSI colours in the log output.
# NO_COLOR=1
