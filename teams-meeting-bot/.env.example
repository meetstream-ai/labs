# ─────────────────────────────────────────────
#  MeetStream - Microsoft Teams meeting bot
# ─────────────────────────────────────────────

# Required. Your MeetStream API key (https://app.meetstream.ai).
# Sent as `Authorization: Token <key>` - the literal word "Token", not "Bearer".
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# Optional. Override the API base URL (defaults to https://api.meetstream.ai/api/v1).
# MEETSTREAM_BASE_URL=https://api.meetstream.ai/api/v1

# Required. The Teams meeting join link, exactly as it appears in the invite.
MEETING_LINK=https://teams.microsoft.com/l/meetup-join/...

# Display name shown in the meeting.
BOT_NAME=MeetStream Notetaker

# Record video as well as audio.
VIDEO_REQUIRED=false

# Optional. Join later instead of now. ISO 8601, UTC.
# JOIN_AT=2026-09-01T15:00:00Z


# ── Webhook receiver ───────────────────────────────────────────────────────────

PORT=3000
WEBHOOK_PATH=/webhook

# Required for `node index.js`. The public https origin that reaches this server
# (ngrok, Cloudflare tunnel, deployed host). callback_url = this + WEBHOOK_PATH.
PUBLIC_WEBHOOK_URL=https://your-tunnel.ngrok-free.app

# Optional. Per-bot callback_url deliveries are NOT signed - set this only when
# receiving on a dashboard workspace webhook endpoint.
# WEBHOOK_SECRET=your_workspace_endpoint_secret

# Optional. Alerts are POSTed here as JSON in addition to being logged.
# NOTIFY_WEBHOOK_URL=https://your-app.example.com/alerts


# ── automatic_leave (all optional; Teams defaults shown) ───────────────────────

# How long to wait for admission. Teams range 60-1800, default 600.
# WAITING_ROOM_TIMEOUT=600

# Leave if nobody ever joins. Range 60-1800, default 600.
# NO_ONE_JOINED_TIMEOUT=600

# Leave once the participant count hits zero. Range 60-1800, default 300.
# EVERYONE_LEFT_TIMEOUT=300

# Leave after a stretch of silence. Practical range 60-1800, default 100.
# VOICE_INACTIVITY_TIMEOUT=300

# Hard cap on total recording time. Range 600-18000, default 14400 (4 hours).
# IN_CALL_RECORDING_TIMEOUT=14400

# Note: recording_permission_denied_timeout is Zoom only and has no effect here.


# ── Transcription (optional) ───────────────────────────────────────────────────

# One of: deepgram | assemblyai | sarvam | jigsawstack | meetstream | meeting_captions
# meeting_captions uses Teams' own native captions - with it, the create_bot
# response returns transcript_id: null.
# TRANSCRIPT_PROVIDER=deepgram
# TRANSCRIPT_LANGUAGE=en

# Delete stored media after this many hours.
# RETENTION_HOURS=72
