# ---------------------------------------------
#  calendar-event-sync
# ---------------------------------------------

# Required. Your MeetStream API key from https://app.meetstream.ai
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# Optional. How far ahead to look, in days. Default 14.
# The API caps the default window at now + 28 days.
SYNC_DAYS_AHEAD=14

# Optional. Events per page, 1 to 100. Default 50.
SYNC_PAGE_SIZE=50

# Optional. Stop after this many events across all pages. Default 200.
SYNC_MAX_EVENTS=200

# Optional. Sync one specific calendar instead of the primary one.
# CALENDAR_ID=team-meetings@group.calendar.google.com

# Optional, multi-account users only. "google" or "outlook".
# CALENDAR_PROVIDER=outlook

# Optional, multi-account users only. Requires CALENDAR_PROVIDER.
# CALENDAR_ACCOUNT_ID=jane@acme.com

# Optional. Only change this if you are pointing at a non-production API.
# MEETSTREAM_API_BASE_URL=https://api.meetstream.ai/api/v1
