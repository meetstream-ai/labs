# === MeetStream API ===
# Your MeetStream API key (Token auth). Found in the MeetStream dashboard.
MEETSTREAM_API_KEY=

# The meeting the bot should join (Google Meet / Zoom / Microsoft Teams link).
MEETING_LINK=

# Display name the bot uses inside the meeting.
BOT_NAME=MeetStream Recorder

# Layout of the COMPOSITE video recording: "speaker_view" or "grid_view".
# The API default is grid_view, so speaker view is sent explicitly. This has no
# effect on the per-participant video files.
#
# Note: per-participant video (video_separate_streams) is always on in this
# template, because that is what it is for. It is an explicit opt-in and stays
# off in every other template.
VIDEO_LAYOUT=speaker_view

# === Server ===
# Local port for the Express server. ngrok tunnels to this port.
PORT=3000

# === ngrok ===
# Auth token from https://dashboard.ngrok.com/get-started/your-authtoken
# Required so the webhook endpoint is reachable by MeetStream without any
# manual `ngrok http` commands or extra terminals.
NGROK_AUTHTOKEN=

# Optional: a reserved/static ngrok domain (e.g. "my-app.ngrok-free.app").
# Leave blank to let ngrok assign a random domain each run.
NGROK_DOMAIN=

# === Output ===
# Where per-participant recordings are written.
OUTPUT_DIR=./recordings

# === Logging ===
# One of: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# === Retry / rate limiting ===
# Max retry attempts for transient MeetStream API failures (429 / 5xx / timeout).
MAX_RETRIES=5
# Base delay (ms) for exponential backoff between retries.
RETRY_BASE_DELAY_MS=1000
# Per-request timeout (ms).
REQUEST_TIMEOUT_MS=30000

# === Meeting lifecycle ===
# Safety timeout (minutes): if the bot never reports the meeting as finished,
# shut down gracefully anyway instead of hanging forever.
MAX_MEETING_WAIT_MINUTES=180

# After Ctrl+C, resend remove_bot until MeetStream confirms bot.stopped.
BOT_STOP_MAX_ATTEMPTS=6
BOT_STOP_RETRY_MS=10000

# === Recording readiness polling ===
# After the meeting ends (bot leaves, gets kicked, or you press Ctrl+C),
# MeetStream needs a little time to process recordings before they can be
# downloaded. These control the bounded check-and-wait loop used to detect
# when they're ready, as a fallback in case a "recording ready" webhook
# event never arrives.
RECORDING_POLL_MAX_ATTEMPTS=20
RECORDING_POLL_INTERVAL_MS=15000
