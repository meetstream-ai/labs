# MeetStream API key - https://app.meetstream.ai/api-key
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# Port the local server listens on
PORT=3000

# Public HTTPS URL that MeetStream will POST live transcript chunks to.
# Use an ngrok/cloudflared tunnel in local dev, e.g. https://abc123.ngrok-free.app/webhook
WEBHOOK_URL=https://your-tunnel-url.ngrok-free.app/webhook

# WebSocket mode only (npm run start:ws) - public wss:// URL of your ws-server
WEBSOCKET_URL=wss://your-tunnel-url.ngrok-free.app
