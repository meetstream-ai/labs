# Required for create-bot / create-bot-ws. MeetStream API key - https://app.meetstream.ai/api-key
# Sent as `Authorization: Token <key>` - the literal word Token, not Bearer.
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# Port the local server listens on. Default 3000 for the webhook server, 3001 for the WebSocket server.
# PORT=3000

# Webhook mode: public HTTPS BASE URL of your tunnel, WITHOUT a path.
# The bot script appends /webhook itself. Use an ngrok/cloudflared tunnel in local dev.
WEBHOOK_URL=https://your-tunnel-url.ngrok-free.app

# WebSocket mode only (npm run start:ws): public wss:// BASE URL of your ws-server.
# The bot script appends /ws itself.
WEBSOCKET_URL=wss://your-tunnel-url.ngrok-free.app

# Streaming provider for the bot: deepgram (default) or assemblyai.
# PROVIDER=deepgram
