# ---------------------------------------------------------------------------
# MeetStream bot-lifecycle-state-machine
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Local port for the webhook receiver.
PORT=3000

# Path the receiver listens on. Your callback_url must end with this exact path.
WEBHOOK_PATH=/webhook

# Where bot state is persisted. Atomic writes (temp file + rename), so a crash
# cannot leave a truncated file. Swap BotStore for your database in production.
STATE_FILE=./data/bots.json

# How often the stuck/abandoned scan runs, in milliseconds.
MONITOR_INTERVAL_MS=30000

# Fallback for bots whose custom_attributes do not carry `streaming_only`.
# The transcription provider decides whether a post-call transcript arrives:
#   post-call providers   transcription.processed / .failed, then bot.done
#   streaming-only        no transcription events, straight to bot.done
# Every bot's lifecycle ends at bot.done either way.
# Best practice is to stamp custom_attributes.streaming_only ("true"/"false")
# at create_bot time so each bot carries its own answer.
DEFAULT_STREAMING_ONLY=false
