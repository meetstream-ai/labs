# ---------------------------------------------
#  zoom-authenticated-joins
#  Copy to .env and fill in. Never commit .env.
# ---------------------------------------------

# Required for create-bot. Your MeetStream API key from https://app.meetstream.ai
# Sent as `Authorization: Token <key>`.
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# Required. Your Zoom General App (Zoom App Marketplace -> Develop -> Build App).
# Use the same app whose Client ID / Secret you saved in the MeetStream
# dashboard (Integrations -> Zoom), with Meeting SDK enabled.
# Scopes: user:read:zak (ZAK) and user:read:token (OBF).
ZOOM_CLIENT_ID=your_zoom_client_id_here
ZOOM_CLIENT_SECRET=your_zoom_client_secret_here

# Required. The public https URL that reaches this server. MeetStream bots run
# in AWS and cannot reach localhost, so for local development run a tunnel:
#
#   ngrok http 3000
#   cloudflared tunnel --url http://localhost:3000
#
# No trailing slash.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# Optional. Defaults to PUBLIC_BASE_URL + /zoom/callback. Must match the
# redirect URL registered on the Zoom app exactly (scheme, host, path, slash).
# ZOOM_REDIRECT_URI=https://your-subdomain.ngrok-free.app/zoom/callback

# Required. Shared secret carried as ?auth= on every mint URL. The mint URL is
# a credential: anyone holding it can get a Zoom token for that user.
# Generate one with: openssl rand -hex 32
MINT_SHARED_SECRET=your_long_random_secret_here

# Optional. Local port. Point the tunnel at it.
PORT=3000

# Optional. Where refresh tokens are written (gitignored). Use a real secret
# store in production.
# DATA_DIR=./data

# Optional. Only change this if you are pointing at a non-production API.
# MEETSTREAM_API_BASE_URL=https://api.meetstream.ai/api/v1
