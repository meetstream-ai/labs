# ─────────────────────────────────────────────────────────────
#  MeetStream Labs: WebSocket Bot Control
#  Copy this file to .env and fill it in.
# ─────────────────────────────────────────────────────────────

# Required. MeetStream dashboard -> API Keys.
# https://app.meetstream.ai
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# Required. The meeting the bot should join.
MEETING_LINK=https://meet.google.com/xxx-xxxx-xxx

# ─────────────────────────────────────────────────────────────
#  Public URL: pick ONE of the two
#  The bot dials OUT to your control socket, so it must be reachable
#  from the public internet over wss://
# ─────────────────────────────────────────────────────────────

# Option A: you already have a public HTTPS endpoint pointing at this process.
# PUBLIC_URL=https://control.example.com

# Option B: let the template open an ngrok tunnel for you (free account is fine).
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# ─────────────────────────────────────────────────────────────
#  Optional
# ─────────────────────────────────────────────────────────────

# Local port for the HTTP + WebSocket server (default 3000)
# PORT=3000

# Display name of the bot in the participant list
# BOT_NAME=MeetStream Labs Control Bot

# Sent as a sendmsg the moment the control channel is ready. Empty = no greeting.
# GREETING=Hi everyone, the assistant is connected.
