# ─────────────────────────────────────────────────────────────
#  MeetStream
# ─────────────────────────────────────────────────────────────

# Required. Create one at https://app.meetstream.ai under API Keys.
# Sent as `Authorization: Token <key>` - the literal word Token, not Bearer.
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# The meeting the bot should join (Zoom, Google Meet or Microsoft Teams).
# You can also pass it as: node index.js --meeting "<url>"
MEETING_LINK=https://meet.google.com/xxx-xxxx-xxx

BOT_NAME=Notetaker

# Post-call transcription provider:
#   deepgram | assemblyai | sarvam | jigsawstack | meetstream
# Never a *_streaming provider here - those never produce a post-call transcript.
TRANSCRIPT_PROVIDER=meetstream
TRANSCRIPT_LANGUAGE=en

# ─────────────────────────────────────────────────────────────
#  Webhook (live mode only)
# ─────────────────────────────────────────────────────────────

# Public HTTPS base URL MeetStream can POST to. callback_url becomes ${PUBLIC_BASE_URL}/webhook.
# Dev: `ngrok http 3000` or `cloudflared tunnel --url http://localhost:3000`
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app
PORT=3000

TRANSCRIPT_POLL_ATTEMPTS=20
TRANSCRIPT_POLL_INTERVAL_MS=5000

# ─────────────────────────────────────────────────────────────
#  Slack - pick ONE of the two
# ─────────────────────────────────────────────────────────────

# Option A: incoming webhook. Simplest. One fixed channel, no thread replies.
# Create at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxxxxxxxxxx

# Option B: bot token. Needs the `chat:write` scope, and the bot must be
# invited to the channel (/invite @your-bot). Lets us thread the transcript.
# If both options are set, the bot token wins.
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_CHANNEL=#meeting-notes

# {date} is replaced with today's date.
SLACK_MESSAGE_TITLE=Meeting notes - {date}

# Post the full transcript as a reply in the message thread. Bot token only.
POST_TRANSCRIPT_IN_THREAD=false
TRANSCRIPT_THREAD_TURNS=60

# ─────────────────────────────────────────────────────────────
#  Action items (optional)
# ─────────────────────────────────────────────────────────────

# Leave both blank and the message is posted without an action items section.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL=gpt-4o-mini

# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Cap on how much transcript is sent to the model.
LLM_MAX_TRANSCRIPT_CHARS=60000
