# ---------------------------------------------------------------------------
# MeetStream error-handling-and-retries
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Your MeetStream API key. https://app.meetstream.ai
# Optional: the offline matrix (`node index.js`) needs no key at all.
# Used by `--live` for the 400 and 404 probes. The 401 and 403 probes
# deliberately send no key / a fake key and ignore this value.
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# API base URL. Change only if you were given a different host.
MEETSTREAM_BASE_URL=https://api.meetstream.ai/api/v1

# Set to any value to disable ANSI colours in the log output.
# NO_COLOR=1

# Recording defaults: audio only. `video_required: false` is sent explicitly,
# because the REST API treats an omitted `video_required` as true. There is no
# video env var here; if you enable video in code, also send
# `recording_config.video_layout: "speaker_view"` (the API default is
# `grid_view`). `video_separate_streams` is never set implicitly.

