NGROK_AUTHTOKEN=replace-with-ngrok-authtoken
# Optional stable reserved domain. Without this, ngrok assigns a temporary URL.
# NGROK_DOMAIN=your-domain.ngrok.app
# Set this instead of ngrok in production.
# PUBLIC_BASE_URL=https://bridge.example.com
# Optional. Protects the advanced /v1 management API. Generate your own value.
BRIDGE_API_KEY=
MIA_HERMES_WEBHOOK_SECRET=
# Required. Copy from the MeetStream dashboard.
MEETSTREAM_API_KEY=replace-with-meetstream-api-key
# Optional. Leave blank to let this example create/reuse its transport-only MIA config.
MEETSTREAM_MIA_CONFIG_ID=
HERMES_GATEWAY_URL=http://127.0.0.1:8080/v1
# Optional if ~/.hermes/.env already contains API_SERVER_KEY.
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
HERMES_API_MODE=auto
MEETING_URL=https://meet.google.com/abc-defg-hij
BOT_NAME=Hermes Meeting Agent
# Comma-separated activation phrases. Set WAKE_WORDS=off to answer every finalized spoken turn.
WAKE_WORDS=hey assistant,hey hermes,hey bot,okay agent,okay bot
OUTPUT_MODE=chat
PORT=3000
HOST=127.0.0.1
