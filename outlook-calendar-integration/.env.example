# ---------------------------------------------
#  outlook-calendar-integration
# ---------------------------------------------

# Required. Your MeetStream API key from https://app.meetstream.ai
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# Required. Application (client) ID from Azure Portal >
# App registrations > your app > Overview.
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here

# Required. The client secret VALUE (not the secret id) from
# App registrations > your app > Certificates & secrets.
# Azure shows it exactly once, right after you create it.
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here

# Required for `npm start`, produced by `npm run oauth`.
MICROSOFT_REFRESH_TOKEN=your_microsoft_refresh_token_here

# Optional. Directory (tenant) ID, or one of the special values:
#   common        work/school and personal Microsoft accounts (default)
#   organizations work/school accounts only
#   consumers     personal Microsoft accounts only
MICROSOFT_TENANT_ID=common

# Optional. Port the local OAuth helper listens on. Default 3000.
# If you change it, add the matching redirect URI in the Azure Portal:
#   http://localhost:<OAUTH_PORT>/api/microsoft/oauth-callback
OAUTH_PORT=3000

# Optional. Only change this if you are pointing at a non-production API.
# MEETSTREAM_API_BASE_URL=https://api.meetstream.ai/api/v1
