# ─────────────────────────────────────────────────────────────
#  MeetStream Labs - multilingual-transcription
# ─────────────────────────────────────────────────────────────

# Required. Your MeetStream API key (https://app.meetstream.ai).
# Sent as: Authorization: Token <key>
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# The meeting to join. Zoom, Google Meet, or Microsoft Teams.
# Can also be passed as the first CLI argument.
MEETING_LINK=https://meet.google.com/xxx-xxxx-xxx

# Provider: deepgram | assemblyai | sarvam | jigsawstack | meetstream
# Rule of thumb:
#   Indic languages           -> sarvam
#   European / East Asian     -> deepgram or assemblyai
#   Unknown or mixed language -> jigsawstack or meetstream ("auto")
PROVIDER=deepgram

# Language code IN THE PROVIDER'S OWN FORMAT.
# Run `node index.js --languages` for the per-provider catalogue.
#   deepgram    -> language:      "en"  "es"  "hi"  "ja"
#   assemblyai  -> language_code: "en_us"  "es"  "fr"  "de"
#   sarvam      -> language_code: "hi-IN"  "ta-IN"  "te-IN"  "en-IN"
#   jigsawstack -> language:      "auto" or an ISO code
#   meetstream  -> language:      "auto" or an ISO code
LANGUAGE=

# jigsawstack / meetstream only: translate the transcript to English.
TRANSLATE=false

# Request speaker labels where the provider supports it.
DIARIZE=false

# Optional provider-specific overrides.
# DEEPGRAM_MODEL=nova-3
# ASSEMBLYAI_SPEECH_MODELS=          # comma-separated array; see AssemblyAI docs
# SARVAM_MODEL=
# SARVAM_MODE=

# Display name of the bot in the meeting.
BOT_NAME=MeetStream Labs Bot

# Optional. Lifecycle webhook (events arrive under the "event" key).
# CALLBACK_URL=https://your-server.example.com/webhook

# How long MeetStream keeps the recording. retention.type is always "timed".
RETENTION_HOURS=24

# Status polling while the bot is in the meeting.
STATUS_POLL_INTERVAL_MS=15000
MAX_STATUS_POLLS=240

# Polling cap for HTTP 202 ("transcript not ready yet").
MAX_POLL_ATTEMPTS=36
POLL_INTERVAL_MS=5000

# Where the .json and .txt outputs are written.
OUTPUT_DIR=transcripts

# Optional. Override the API base URL (self-hosted / staging only).
# MEETSTREAM_API_BASE_URL=https://api.meetstream.ai/api/v1
