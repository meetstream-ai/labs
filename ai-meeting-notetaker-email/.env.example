# ─────────────────────────────────────────────────────────────
#  MeetStream
# ─────────────────────────────────────────────────────────────

# Required. Create one at https://app.meetstream.ai under API Keys.
# Sent as `Authorization: Token <key>` - the literal word Token, not Bearer.
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# The meeting the bot should join (Zoom, Google Meet or Microsoft Teams).
# You can also pass it as: node index.js --meeting "<url>"
MEETING_LINK=https://meet.google.com/xxx-xxxx-xxx

# Display name of the bot inside the meeting.
BOT_NAME=Notetaker

# Post-call transcription provider. One of:
#   deepgram | assemblyai | sarvam | jigsawstack | meetstream
# Do NOT use a *_streaming provider here - streaming providers never produce a
# post-call transcript, so get_transcript would return HTTP 202 forever.
TRANSCRIPT_PROVIDER=meetstream
TRANSCRIPT_LANGUAGE=en

# Optional: delete the recording after N hours (recording_config.retention).
# RETENTION_HOURS=72

# ─────────────────────────────────────────────────────────────
#  Webhook (live mode only)
# ─────────────────────────────────────────────────────────────

# Public HTTPS base URL that MeetStream can POST events to. The bot's
# callback_url becomes ${PUBLIC_BASE_URL}/webhook.
# In development: `ngrok http 3000` or `cloudflared tunnel --url http://localhost:3000`
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app

# Local port for the webhook server.
PORT=3000

# How long to poll get_transcript before giving up (attempts x interval).
TRANSCRIPT_POLL_ATTEMPTS=20
TRANSCRIPT_POLL_INTERVAL_MS=5000

# ─────────────────────────────────────────────────────────────
#  Email delivery
# ─────────────────────────────────────────────────────────────

# resend | sendgrid | smtp | console
# `console` prints the email instead of sending it - use it to test the flow.
EMAIL_PROVIDER=console

# Sender address. Required for every provider except `console`.
EMAIL_FROM=Meeting Notes <notes@yourdomain.com>

# Comma-separated recipients.
EMAIL_TO=you@yourdomain.com,teammate@yourdomain.com

# Also email everyone the meeting platform reported as an attendee (when it
# exposes their email addresses).
SEND_TO_PARTICIPANTS=false

# {date} is replaced with today's date.
EMAIL_SUBJECT=Meeting notes - {date}

# How many speaker turns of transcript to inline in the email body.
TRANSCRIPT_EXCERPT_TURNS=40

# --- EMAIL_PROVIDER=resend ---
RESEND_API_KEY=re_your_resend_api_key

# --- EMAIL_PROVIDER=sendgrid ---
SENDGRID_API_KEY=SG.your_sendgrid_api_key

# --- EMAIL_PROVIDER=smtp ---
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
# true forces implicit TLS; leave unset to infer from the port (465 = true).
# SMTP_SECURE=false
