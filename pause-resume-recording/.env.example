# === Required ===

# Your MeetStream API key. Sent as `Authorization: Token <key>`.
# Get one at https://app.meetstream.ai
MEETSTREAM_API_KEY=your_api_key_here

# === Pick ONE of these two ===

# A) Start a new bot and control its recording.
MEETING_LINK=https://meet.google.com/abc-defg-hij

# B) Control a bot that is already in a meeting.
BOT_ID=

# === Optional ===

# Display name the bot uses inside the meeting.
BOT_NAME=MeetStream Recorder

# Seconds the bot waits after everyone else leaves before it leaves too.
EVERYONE_LEFT_TIMEOUT=60

# Used only when stdin is not a TTY (CI, piped input, nohup), where
# single-key control is impossible. Format: "<seconds>:<pause|resume|stop>"
# separated by commas, relative to bot creation.
AUTO_SEQUENCE=30:pause,60:resume,90:stop

# HTTP behaviour
REQUEST_TIMEOUT_MS=30000
MAX_RETRIES=4

# One of: silent, error, warn, info, debug
LOG_LEVEL=info
