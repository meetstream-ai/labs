# ─────────────────────────────────────────────────────────────
#  MeetStream
# ─────────────────────────────────────────────────────────────

# Required. Create one at https://app.meetstream.ai under API Keys.
# Sent as `Authorization: Token <key>` - the literal word Token, not Bearer.
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# The sales call the bot should join (Zoom, Google Meet or Microsoft Teams).
# You can also pass it as: node index.js --meeting "<url>"
MEETING_LINK=https://us02web.zoom.us/j/000000000

BOT_NAME=Notetaker

# Post-call transcription provider:
#   deepgram | assemblyai | sarvam | jigsawstack | meetstream
# Never a *_streaming provider - those never produce a post-call transcript.
TRANSCRIPT_PROVIDER=meetstream
TRANSCRIPT_LANGUAGE=en

# ─────────────────────────────────────────────────────────────
#  Webhook (live mode only)
# ─────────────────────────────────────────────────────────────

# Public HTTPS base URL MeetStream can POST to. callback_url becomes ${PUBLIC_BASE_URL}/webhook.
# Dev: `ngrok http 3000` or `cloudflared tunnel --url http://localhost:3000`
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app
PORT=3000

TRANSCRIPT_POLL_ATTEMPTS=20
TRANSCRIPT_POLL_INTERVAL_MS=5000

# ─────────────────────────────────────────────────────────────
#  HubSpot
# ─────────────────────────────────────────────────────────────

# Private app access token: HubSpot Settings > Integrations > Private Apps.
# Required scopes: crm.objects.contacts.read, crm.objects.deals.read, crm.objects.notes.write
HUBSPOT_ACCESS_TOKEN=pat-na1-your-private-app-token

# Optional. Only used to print a clickable link to the created note.
# HUBSPOT_PORTAL_ID=12345678

# Attendee emails to match on, comma separated. Meeting platforms often do not
# expose attendee emails, so this is the reliable path.
# Also available as: node index.js --emails "buyer@acme.com,champion@acme.com"
ATTENDEE_EMAILS=buyer@acme.com

# Never log the note against your own team's contacts.
EXCLUDE_EMAIL_DOMAINS=yourcompany.com

# Also associate the note with every deal linked to the matched contacts.
ATTACH_TO_DEALS=true

# Include the full transcript in the note body, not just the summary.
INCLUDE_TRANSCRIPT=true
NOTE_MAX_TRANSCRIPT_TURNS=200

# {date} is replaced with today's date.
NOTE_TITLE=Meeting notes - {date}

# ─────────────────────────────────────────────────────────────
#  Action items (optional)
# ─────────────────────────────────────────────────────────────

# Leave both blank and the note is logged without action items.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL=gpt-4o-mini

# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# ANTHROPIC_MODEL=claude-sonnet-4-5

LLM_MAX_TRANSCRIPT_CHARS=60000
