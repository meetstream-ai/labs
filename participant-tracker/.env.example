# === Required ===
# Your MeetStream API key. Get one at https://app.meetstream.ai
# Sent as `Authorization: Token <key>` (literally "Token", not "Bearer").
MEETSTREAM_API_KEY=

# === Mode: pick ONE ===
#
# REPORT MODE - rebuild attendance for a meeting that already happened.
# No webhook server is started. Wins over MEETING_LINK if both are set.
BOT_ID=

# LIVE MODE - send a bot into a meeting and track joins/leaves as they happen.
# Requires PUBLIC_URL below.
MEETING_LINK=

# === Live mode only ===
# Local port the webhook server listens on.
PORT=3000

# The public https:// base URL that forwards to PORT. MeetStream must be able
# to reach this from the internet. Get one with:
#   ngrok http 3000
#   cloudflared tunnel --url http://localhost:3000
# No trailing slash. Two routes are registered under it:
#   <PUBLIC_URL>/webhook       bot lifecycle events (callback_url)
#   <PUBLIC_URL>/participants  participant_events.join / .leave
PUBLIC_URL=

# How long to keep listening after the meeting ends, so trailing webhooks land.
WEBHOOK_DRAIN_MS=5000

# === Bot options (only used when creating a bot) ===
BOT_NAME=MeetStream Attendance Bot
TRANSCRIPT_LANGUAGE=en
RETENTION_HOURS=72

# automatic_leave timeouts, in seconds.
# Note: in_call_recording_timeout has a hard API minimum of 600.
WAITING_ROOM_TIMEOUT=600
EVERYONE_LEFT_TIMEOUT=600
IN_CALL_RECORDING_TIMEOUT=14400

# Optional Idempotency-Key UUID for create_bot. Leave blank to generate one
# per run. A replay returns HTTP 507, which is treated as success.
IDEMPOTENCY_KEY=

# === Waiting for the meeting to end ===
# The bot.stopped webhook and this status poll race each other, so a dropped
# webhook cannot hang the run.
STATUS_POLL_INTERVAL_MS=15000
STATUS_POLL_MAX_ATTEMPTS=240

# === Output ===
OUTPUT_DIR=./output

# === HTTP behaviour ===
REQUEST_TIMEOUT_MS=30000
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1000

# Override only for a non-production MeetStream environment.
# MEETSTREAM_BASE_URL=https://api.meetstream.ai/api/v1
