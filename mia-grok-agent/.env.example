# Copy this file to .env and fill in the values. Never commit .env.

# Required. Get a key at https://app.meetstream.ai
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# Required. Full Google Meet, Zoom, or Microsoft Teams link.
MEETING_LINK=https://meet.google.com/abc-defg-hij

# Recommended for a live take. Run once, copy the printed id here, and later
# runs reuse the saved Grok agent instead of creating one at the last second.
# MEETSTREAM_AGENT_CONFIG_ID=

# Recording defaults: audio only. `video_required: false` is sent explicitly,
# because the REST API treats an omitted `video_required` as true. There is no
# video env var here; if you enable video in code, also send
# `recording_config.video_layout: "speaker_view"` (the API default is
# `grid_view`). `video_separate_streams` is never set implicitly.

# ---------------------------------------------------------------------------
# Grok. MeetStream connects to xAI itself; there is no xAI key in this file.
# The xAI integration must be available on your MeetStream account.
# ---------------------------------------------------------------------------

# Built-in voices (28, any case): ara, eve, leo, rex, sal and more; see
# https://docs.x.ai/developers/model-capabilities/audio/voice
GROK_VOICE=Ara

# Optional. Leave unset to use MeetStream's default Grok voice model.
# GROK_MODEL=

# Optional. Spoken as soon as the bot is admitted. Empty by default, so Grok
# waits until someone talks to it.
# GROK_FIRST_MESSAGE=Hi everyone, I'm Grok. I'm in the call and listening.

# Optional. Replaces the default meeting-participant prompt.
# GROK_SYSTEM_PROMPT=

# Optional. `launch-demo` is the scripted prompt the first real call was recorded
# with (the same as `npm run demo`). Leave unset for free-form answers.
# GROK_SCRIPT=launch-demo

# Optional. true asks MeetStream for a post-call transcript, so `npm run verify -- <bot_id>`
# can check the recording straight after the call. Default false.
# TRANSCRIBE=false

# true: talking over Grok stops it. Set false when recording in a noisy room.
# GROK_ALLOW_INTERRUPTIONS=true

# Display name of the bot in the meeting.
BOT_NAME=Grok

# Saved agent name in the MeetStream dashboard.
# MIA_AGENT_NAME=Grok Meeting Demo

# Optional. Public HTTPS endpoint that receives per-bot lifecycle webhooks.
# CALLBACK_URL=https://your-domain.example/webhooks/meetstream

# Optional. Delete the agent config when the program exits (default false).
# DELETE_AGENT_ON_EXIT=false

# Optional. How often to poll bot status, in seconds (default 5).
# POLL_INTERVAL_SECONDS=5

# Optional. Override only if MeetStream gave you a different base URL.
# MEETSTREAM_BASE_URL=https://api.meetstream.ai/api/v1
