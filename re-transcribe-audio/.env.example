# ─────────────────────────────────────────────────────────────
#  MeetStream Labs - re-transcribe-audio
# ─────────────────────────────────────────────────────────────

# Required. Your MeetStream API key (https://app.meetstream.ai).
# Sent as: Authorization: Token <key>
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# The bot whose recorded audio should be transcribed again. Can also be passed
# as the first CLI argument: `node index.js <bot_id>`.
BOT_ID=

# Post-call provider to run: deepgram | assemblyai | sarvam | jigsawstack | meetstream
# Streaming providers (*_streaming, meeting_captions) are rejected - there is
# nothing to re-run against a finished recording.
PROVIDER=deepgram

# Language code IN THE PROVIDER'S OWN FORMAT. Leave blank for the default.
#   deepgram    -> language:      "en", "es", "hi"
#   assemblyai  -> language_code: "en_us", "es", "fr"
#   sarvam      -> language_code: "hi-IN", "ta-IN", "en-IN"
#   jigsawstack -> language:      "auto" (detects) or an ISO code
#   meetstream  -> language:      "auto" (detects) or an ISO code
LANGUAGE=

# Ask for speaker labels where the provider supports it:
#   deepgram -> diarize, assemblyai -> speaker_labels,
#   sarvam -> with_diarization, jigsawstack -> by_speaker
DIARIZE=false

# jigsawstack / meetstream only: translate the output to English.
TRANSLATE=false

# Optional provider-specific overrides.
# DEEPGRAM_MODEL=nova-3
# ASSEMBLYAI_SPEECH_MODELS=          # comma-separated; see AssemblyAI docs
# SARVAM_MODEL=

# Optional. Webhook notified when the run finishes
# (transcription.processed / transcription.failed).
# CALLBACK_URL=https://your-server.example.com/webhook

# Poll for the finished transcript after triggering the run.
# Set to false to fire and forget (useful with CALLBACK_URL).
WAIT_FOR_TRANSCRIPT=true

# Polling cap for HTTP 202 ("transcript not ready yet").
MAX_POLL_ATTEMPTS=36
POLL_INTERVAL_MS=5000

# Where the .json and .txt outputs are written.
OUTPUT_DIR=transcripts

# Optional. Override the API base URL (self-hosted / staging only).
# MEETSTREAM_API_BASE_URL=https://api.meetstream.ai/api/v1
