# ---------------------------------------------
#  google-calendar-integration
# ---------------------------------------------

# Required. Your MeetStream API key from https://app.meetstream.ai
MEETSTREAM_API_KEY=

# Required. OAuth 2.0 Client ID from Google Cloud Console >
# APIs & Services > Credentials. Application type must be "Web application".
GOOGLE_CLIENT_ID=

# Required. The client secret shown next to that OAuth client.
GOOGLE_CLIENT_SECRET=

# Required for `node index.js`, produced by `npm run oauth`.
# Long-lived. Google only issues one on first consent or after a revoke.
GOOGLE_REFRESH_TOKEN=

# Optional. Port the local OAuth helper listens on. Default 3000.
# If you change it, add the matching redirect URI in Google Cloud Console:
#   http://localhost:<OAUTH_PORT>/api/google/oauth-callback
# OAUTH_PORT=3000

# Optional. Only change this if you are pointing at a non-production API.
# MEETSTREAM_API_BASE_URL=https://api.meetstream.ai/api/v1
