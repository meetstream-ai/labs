# ---------------------------------------------------------------------------
# MeetStream bulk-bot-operations
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Your MeetStream API key. https://app.meetstream.ai
# Not needed for --simulate or --dry-run.
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# API base URL. Change only if you were given a different host.
MEETSTREAM_BASE_URL=https://api.meetstream.ai/api/v1

# Batch definition. See jobs.example.json for the shape.
JOBS_FILE=./jobs.json

# How many create_bot calls are in flight at once. Start low and raise it while
# watching for 429s. Every request already retries with backoff, but the
# cheapest way to avoid rate limiting is to not trip it.
CONCURRENCY=5

# Delay between STARTS, in milliseconds. Smooths the initial burst so all
# CONCURRENCY workers do not fire in the same instant.
STAGGER_MS=100

# Attempts per job, including the first. Retries reuse the same
# Idempotency-Key, so they cannot duplicate a bot.
MAX_ATTEMPTS=4

# Stable id for this batch. It seeds every job's Idempotency-Key, so re-running
# the same file with the same BATCH_ID replays finished jobs (HTTP 507) instead
# of creating duplicates. Leave unset to get a timestamp, which means every run
# is treated as a NEW batch.
# BATCH_ID=nightly-2026-08-23

# Where the JSON report is written.
# REPORT_PATH=./output/batch-<batch id>.json

# Per-bot webhook. Must be public HTTPS. There is no account-wide webhook
# setting, so a bot created without this produces no events at all.
# See the webhook-local-tunnel template to get a URL for local development.
# CALLBACK_URL=https://your-domain.example.com/webhook

# Defaults applied to any job that does not set its own.
#   Post-call:  deepgram | assemblyai | sarvam | jigsawstack | meetstream
#   Streaming:  deepgram_streaming | assemblyai_streaming | jigsawstack_streaming
#               | meetstream_streaming | meeting_captions
DEFAULT_PROVIDER=deepgram
DEFAULT_VIDEO_REQUIRED=false
# DEFAULT_BOT_NAME=Batch Bot
