# ---------------------------------------------
#  calendar-schedule-bot
# ---------------------------------------------

# Required. Your MeetStream API key from https://app.meetstream.ai
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# Optional. The MeetStream event id to act on, the `id` field from
# GET /calendar/events. Leave blank and the template picks the soonest
# upcoming event that has a meeting link and no bot yet.
# EVENT_ID=evt_abc123

# --- bot_config ---

# Optional. Display name the bot uses inside the meeting.
BOT_NAME=MeetStream Calendar Bot

# Optional. "true" records video as well as audio. Default false.
VIDEO_REQUIRED=false

# Optional. Message the bot posts in the meeting chat when it joins.
# BOT_MESSAGE=Recording this meeting for notes.

# Optional. Per-bot webhook that receives the lifecycle events.
# CALLBACK_URL=https://your-domain.com/webhooks/meetstream

# Optional. automatic_leave timeouts, in seconds.
# no_one_joined_timeout is specific to calendar bot_config.
# NO_ONE_JOINED_TIMEOUT=300
# EVERYONE_LEFT_TIMEOUT=60
# WAITING_ROOM_TIMEOUT=600

# Optional. Post-call transcription provider. Leave blank for none.
# One of: deepgram, assemblyai, sarvam, jigsawstack, meetstream
# TRANSCRIPTION_PROVIDER=deepgram
# DEEPGRAM_MODEL=nova-3
# TRANSCRIPTION_LANGUAGE=en

# Optional. Your own dedup key. A replay returns the existing bot,
# reusing the key against a different meeting url returns 409.
# DEDUPLICATION_KEY=my-app-evt_abc123

# Optional. "true" auto-schedules the next occurrence of a recurring
# series after each meeting ends. See the calendar-recurring-events template.
RECURRING_EVENT=false

# --- unschedule options ---

# Optional. "true" cancels the whole recurring series, not just this occurrence.
CANCEL_ALL_OCCURRENCES=false

# Optional. ISO 8601. Only cancel occurrences from this date forward.
# CANCEL_FROM_DATE=2026-05-01T00:00:00Z

# Optional. Only change this if you are pointing at a non-production API.
# MEETSTREAM_API_BASE_URL=https://api.meetstream.ai/api/v1
