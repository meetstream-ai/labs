# ---------------------------------------------
#  MeetStream Post-Call Transcription Bot
# ---------------------------------------------

# Required. Your MeetStream API key (from https://app.meetstream.ai).
# Sent as `Authorization: Token <key>` - the literal word Token, not Bearer.
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# Required. The meeting you want the bot to join.
# Supports: Zoom, Google Meet, Microsoft Teams
MEETING_LINK=https://meet.google.com/xxx-xxxx-xxx

# Required. Free ngrok auth token (from https://dashboard.ngrok.com/get-started/your-authtoken).
# ngrok is bundled - no separate install needed.
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Local port for the webhook server. Default 3000.
PORT=3000

# Display name of the bot in the meeting. Default "MeetStream Transcription Bot".
# BOT_NAME=MeetStream Transcription Bot

# Optional. HMAC secret for webhook signature verification.
# WEBHOOK_SECRET=your_webhook_secret

# Polling cap for HTTP 202 ("transcript not ready yet") after transcription.processed.
# TRANSCRIPT_POLL_ATTEMPTS=12
# TRANSCRIPT_POLL_INTERVAL_MS=5000

# Where the .json and .txt transcript files are written. Default "transcripts".
# OUTPUT_DIR=transcripts

# Optional. Only change this if MeetStream gave you a different base URL.
# MEETSTREAM_BASE_URL=https://api.meetstream.ai/api/v1
