# Optional manual configuration. npm start asks for missing settings and saves them privately.
# Node >=24.9; dsh exactly 0.2.1-rc.5, installed separately.
DSH_BIN=
REPO_PATH=/absolute/path/to/disposable/repository
MEETSTREAM_API_KEY=
MEETSTREAM_BASE_URL=https://api.meetstream.ai
# Leave PUBLIC_URL blank to let npm start manage ngrok. Or configure your own HTTPS connection.
NGROK_AUTHTOKEN=
PUBLIC_URL=
MEETING_URL=
BRIDGE_TOKEN=
PORT=8787
# Connect this provider in MeetStream Integrations first.
MIA_PROVIDER=google
MIA_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
MIA_VOICE=Puck
TASK_TIMEOUT_MS=900000
# Default provider: deepseek-official / deepseek-flash.
DEEPSEEK_API_KEY=
# Set true only when intentionally reusing the installed macOS Harness account.
DSH_ACCOUNT=false
DSH_LOCAL_OLLAMA=false
