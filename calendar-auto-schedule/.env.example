# ---------------------------------------------
#  calendar-auto-schedule
# ---------------------------------------------

# Required. Your MeetStream API key from https://app.meetstream.ai
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# --- default_bot_config: inherited by every auto-scheduled bot ---

# Optional. Display name the bot uses inside every meeting.
BOT_NAME=MeetStream Auto Bot

# Optional. "true" records video as well as audio. Default false.
VIDEO_REQUIRED=false

# Optional. Message the bot posts in the meeting chat when it joins.
# BOT_MESSAGE=Recording this meeting for notes.

# Optional. Public image url for the bot's avatar.
# BOT_IMAGE_URL=https://your-domain.com/bot-avatar.png

# Optional but recommended. Webhook that receives every bot's lifecycle
# events. Without it you have to poll to find out what happened.
# CALLBACK_URL=https://your-domain.com/webhooks/meetstream

# Optional. automatic_leave timeouts, integer seconds.
# WAITING_ROOM_TIMEOUT=600
# NO_ONE_JOINED_TIMEOUT=600
# EVERYONE_LEFT_TIMEOUT=300
# VOICE_INACTIVITY_TIMEOUT=100
# IN_CALL_RECORDING_TIMEOUT=14400
# RECORDING_PERMISSION_DENIED_TIMEOUT=60

# Optional. Post-call transcription provider. Leave blank for none.
# One of: deepgram, assemblyai, sarvam, jigsawstack, meetstream
# TRANSCRIPTION_PROVIDER=deepgram
# DEEPGRAM_MODEL=nova-3
# TRANSCRIPTION_LANGUAGE=en

# Optional. Only change this if you are pointing at a non-production API.
# MEETSTREAM_API_BASE_URL=https://api.meetstream.ai/api/v1
