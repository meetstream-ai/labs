# ---------------------------------------------
#  calendar-disconnect
# ---------------------------------------------

# Required. Your MeetStream API key from https://app.meetstream.ai
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# Optional. The API reference documents the Google OAuth credentials on the
# disconnect body. Set all three and the template includes them; leave them
# blank and it sends the scoped body form documented in the integration guide.
# GOOGLE_CLIENT_ID=your_google_client_id_here
# GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here

# Optional. Only change this if you are pointing at a non-production API.
# MEETSTREAM_API_BASE_URL=https://api.meetstream.ai/api/v1
