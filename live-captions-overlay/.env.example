# ─────────────────────────────────────────────────────────────
#  MeetStream Labs - live-captions-overlay
# ─────────────────────────────────────────────────────────────

# Required. Your MeetStream API key (https://app.meetstream.ai).
# Sent as: Authorization: Token <key>
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# The meeting to join. Zoom, Google Meet, or Microsoft Teams.
# Can also be passed as the first CLI argument.
MEETING_LINK=https://meet.google.com/xxx-xxxx-xxx

# Required. The public HTTPS base URL MeetStream can reach this machine on.
# Start a tunnel first, e.g.  ngrok http 3000
# The template appends /live (transcript chunks) and /webhook (lifecycle).
PUBLIC_URL=https://your-tunnel.ngrok-free.app

# Local port the Express server listens on.
PORT=3000

# MUST be a streaming provider. live_transcription_required with a post-call
# provider (deepgram, assemblyai, sarvam, jigsawstack, meetstream) is HTTP 400.
#   deepgram_streaming | assemblyai_streaming
#   jigsawstack_streaming | meetstream_streaming
PROVIDER=deepgram_streaming

# Language code in the provider's format. Blank uses the provider default.
LANGUAGE=

# Provider tuning (all optional).
# DEEPGRAM_MODEL=nova-3
# TRANSCRIPTION_MODE=sentence      # deepgram_streaming: sentence | word
# ENDPOINTING_MS=300               # deepgram_streaming: silence before an utterance closes
# ASSEMBLYAI_SPEECH_MODEL=         # assemblyai_streaming: singular, a string
# SAMPLE_RATE=48000                # assemblyai_streaming
# ENCODING=pcm_s16le               # assemblyai_streaming

# Display name of the bot in the meeting.
BOT_NAME=MeetStream Captions Bot

# How many committed caption lines stay on screen.
CAPTION_LINES=10

# How long MeetStream keeps the recording. retention.type is always "timed".
RETENTION_HOURS=24

# Remove the bot from the meeting on Ctrl-C (GET /bots/{id}/remove_bot).
REMOVE_BOT_ON_EXIT=true

# Optional. Override the API base URL (self-hosted / staging only).
# MEETSTREAM_API_BASE_URL=https://api.meetstream.ai/api/v1
