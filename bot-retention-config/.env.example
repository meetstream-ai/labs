# ---------------------------------------------
#  bot-retention-config
# ---------------------------------------------

# Required (except for --explain and --dry-run).
# Your MeetStream API key from https://app.meetstream.ai
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# Required. The meeting the bot should join.
MEETING_LINK=https://meet.google.com/xxx-xxxx-xxx

# Optional. "timed" sends recording_config.retention.
# "default" sends no retention block and inherits the API default (24 hours).
# Overridden by --mode on the command line.
RETENTION_MODE=timed

# Optional. Hours to keep recordings and transcripts when RETENTION_MODE=timed.
# Overridden by --hours on the command line.
RETENTION_HOURS=72

# Optional. Display name the bot uses inside the meeting.
BOT_NAME=Retention Demo Bot

# Optional. "true" records video as well as audio.
VIDEO_REQUIRED=false

# Optional. Only change this if you are pointing at a non-production API.
# MEETSTREAM_API_BASE_URL=https://api.meetstream.ai/api/v1
