MEETSTREAM_API_KEY=your_meetstream_api_key
MEETING_LINK=https://meet.google.com/abc-defg-hij

# Saved MIA agent IDs from MeetStream Dashboard.
REALTIME_AGENT_CONFIG_ID=your_realtime_agent_id
PIPELINE_AGENT_CONFIG_ID=your_pipeline_agent_id

# Option A: paste an existing public URL that forwards to this app.
# The app receives events at CALLBACK_URL/webhooks/meetstream.
CALLBACK_URL=

# Option B: let the app start ngrok for you.
NGROK_AUTHTOKEN=

PORT=3001
REALTIME_BOT_NAME=MIA Realtime Agent
PIPELINE_BOT_NAME=MIA Pipeline Agent
