# === Required ===

# Your MeetStream API key. Sent as `Authorization: Token <key>`.
# Get one at https://app.meetstream.ai
MEETSTREAM_API_KEY=your_api_key_here

# === Pick ONE of these two ===

# A) Fetch screenshots from a bot that already ran.
BOT_ID=

# B) Create a new bot, wait for the meeting to end, then fetch screenshots.
MEETING_LINK=https://meet.google.com/abc-defg-hij

# === Optional ===

# Display name the bot uses inside the meeting (mode B only).
BOT_NAME=MeetStream Screenshot Bot

# Where screenshots and the timeline report are written.
OUTPUT_DIR=./screenshots-out

# Seconds the bot waits after everyone else leaves before it leaves too.
EVERYONE_LEFT_TIMEOUT=60

# Phase 1 (mode B only): waiting for the meeting to end.
# 240 attempts x 15s = up to 60 minutes.
MEETING_POLL_MAX_ATTEMPTS=240
MEETING_POLL_INTERVAL_MS=15000

# Phase 2: polling get_screenshots while it answers 202/404.
# Capped so the process cannot hang if screenshots are never produced.
SCREENSHOT_POLL_MAX_ATTEMPTS=30
SCREENSHOT_POLL_INTERVAL_MS=10000

# HTTP behaviour
REQUEST_TIMEOUT_MS=30000
MAX_RETRIES=4

# One of: silent, error, warn, info, debug
LOG_LEVEL=info
