# ---------------------------------------------------------------------------
# MeetStream webhook-local-tunnel
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Local port for the webhook receiver. The tunnel forwards to this port.
PORT=3000

# Path the receiver listens on. callback_url is built as <public url> + this.
WEBHOOK_PATH=/webhook

# How to get a public HTTPS URL:
#   ngrok        stable URLs, free account + one-time `ngrok config add-authtoken`
#   cloudflared  no account, new random URL every run
#   manual       you already have a public URL, set it in TUNNEL_URL below
TUNNEL_PROVIDER=ngrok

# Only used when TUNNEL_PROVIDER=manual. Must be https, no trailing slash.
# TUNNEL_URL=https://your-own-tunnel.example.com

# Print raw tunnel CLI output. Useful when the URL is not being detected.
TUNNEL_VERBOSE=false

# --------------------------- --create-bot only -----------------------------

# Your MeetStream API key. https://app.meetstream.ai
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# API base URL. Change only if you were given a different host.
MEETSTREAM_BASE_URL=https://api.meetstream.ai/api/v1

# The meeting the test bot should join (Zoom / Google Meet / Teams).
MEETING_LINK=https://meet.google.com/xxx-xxxx-xxx

# Display name the bot uses in the meeting.
BOT_NAME=Tunnel Test Bot

# Record video as well as audio. "true" or "false".
VIDEO_REQUIRED=false
