# === Required ===
# Your MeetStream API key. Get one at https://app.meetstream.ai
# Sent as `Authorization: Token <key>` (literally "Token", not "Bearer").
MEETSTREAM_API_KEY=

# === Pick ONE of these two ===
# A bot that already ran. Set this to report on a past meeting. Wins over
# MEETING_LINK.
BOT_ID=

# A live meeting link (Google Meet / Zoom / Microsoft Teams). Set this to send
# a new bot in, wait for the call to finish, then build the report.
MEETING_LINK=

# === Bot options (only used when creating a bot) ===
BOT_NAME=MeetStream Analytics Bot
TRANSCRIPT_LANGUAGE=en
RETENTION_HOURS=72

# automatic_leave timeouts, in seconds.
# Note: in_call_recording_timeout has a hard API minimum of 600.
WAITING_ROOM_TIMEOUT=600
EVERYONE_LEFT_TIMEOUT=600
IN_CALL_RECORDING_TIMEOUT=14400

# Optional Idempotency-Key UUID for create_bot. A replay returns HTTP 507,
# which this template treats as success.
IDEMPOTENCY_KEY=

# === Waiting for the meeting to end ===
STATUS_POLL_INTERVAL_MS=15000
STATUS_POLL_MAX_ATTEMPTS=240

# === Waiting for each data source ===
# Every read endpoint can answer HTTP 202 while processing. Each is polled
# independently with this cap; a source that never becomes ready is reported
# as unavailable rather than failing the whole run.
SECTION_POLL_INTERVAL_MS=10000
SECTION_POLL_MAX_ATTEMPTS=12

# === Audio interpretation ===
# The speaker timeline gives BYTE offsets into the recorded audio file, not
# seconds. Converting needs the encoding:
#   seconds = bytes / (sampleRate * AUDIO_BYTES_PER_SAMPLE * AUDIO_CHANNELS)
# MeetStream audio is 16-bit signed little-endian mono PCM.
# Percentage shares are unaffected by these values.
AUDIO_BYTES_PER_SAMPLE=2
AUDIO_CHANNELS=1

# === Display ===
BAR_WIDTH=30

# === Output ===
OUTPUT_DIR=./output

# Set to false to leave the untouched API responses out of the JSON report
# (smaller file, but no longer self-contained).
INCLUDE_RAW_RESPONSES=true

# === HTTP behaviour ===
REQUEST_TIMEOUT_MS=30000
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1000

# Override only for a non-production MeetStream environment.
# MEETSTREAM_BASE_URL=https://api.meetstream.ai/api/v1
