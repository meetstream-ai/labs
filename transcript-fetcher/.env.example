# ─────────────────────────────────────────────────────────────
#  MeetStream Labs - transcript-fetcher
# ─────────────────────────────────────────────────────────────

# Required. Your MeetStream API key (https://app.meetstream.ai).
# Sent as: Authorization: Token <key>
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# The bot whose transcript you want. Can also be passed as the first CLI
# argument: `node index.js <bot_id>`.
BOT_ID=

# Optional. If you already stored the transcript_id (it is returned by
# POST /bots/create_bot), set it here and the lookup step is skipped entirely.
# TRANSCRIPT_ID=

# Optional. raw=true returns the provider's untouched output instead of
# MeetStream's processed { speaker, transcript } segments.
RAW=false

# Optional. Polling cap for HTTP 202 ("transcript not ready yet").
# 24 attempts x 5000 ms = up to 2 minutes of waiting before giving up.
MAX_POLL_ATTEMPTS=24
POLL_INTERVAL_MS=5000

# Optional. Where the .json and .txt outputs are written.
OUTPUT_DIR=transcripts

# Optional. Override the API base URL (self-hosted / staging only).
# MEETSTREAM_API_BASE_URL=https://api.meetstream.ai/api/v1
