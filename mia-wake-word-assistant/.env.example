# Copy this file to .env and fill in the values. Never commit .env.

# Required. Get a key at https://app.meetstream.ai
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# Required. Full Google Meet, Zoom, or Microsoft Teams link.
MEETING_LINK=https://meet.google.com/abc-defg-hij

# Optional. Reuse a wake-word agent saved by an earlier run.
# MEETSTREAM_AGENT_CONFIG_ID=

# ---------------------------------------------------------------------------
# The wake-word gate
# Comma separated phrases. Include the spellings a transcriber is likely to
# produce, not only the one you would write down. Short two-syllable brand
# names get misheard the most.
# ---------------------------------------------------------------------------
MIA_WAKE_WORDS=hey acme, ok acme, okay acme

# Seconds the agent keeps listening after a phrase fires, so a follow-up
# question does not need the phrase again.
MIA_WAKE_WORD_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Pipeline layers. Wake-word gating is pipeline only.
# ---------------------------------------------------------------------------
MIA_TRANSCRIBER_PROVIDER=deepgram
MIA_TRANSCRIBER_MODEL=nova-3
MIA_TRANSCRIBER_LANGUAGE=en

MIA_MODEL_PROVIDER=openai
MIA_MODEL=gpt-4.1-mini
MIA_SYSTEM_PROMPT=You are the Acme meeting assistant. Answer in one or two short spoken sentences.

MIA_VOICE_PROVIDER=openai
MIA_VOICE_ID=nova

# voice speaks in the meeting, chat posts to meeting chat, action runs tools only.
MIA_RESPONSE_TYPE=voice

# Agent presentation
MIA_AGENT_NAME=Wake Word Meeting Assistant
MIA_FIRST_MESSAGE=Acme assistant here. Say "hey acme" followed by your question.

# Bot settings
BOT_NAME=Acme Assistant

# Optional. Public HTTPS endpoint that receives per-bot lifecycle webhooks.
# CALLBACK_URL=https://your-domain.example/webhooks/meetstream

# Optional. Delete the agent config when the program exits (default false).
# DELETE_AGENT_ON_EXIT=false

# Optional. How often to poll bot status, in seconds (default 10).
# POLL_INTERVAL_SECONDS=10

# Optional. Override only if MeetStream gave you a different base URL.
# MEETSTREAM_BASE_URL=https://api.meetstream.ai/api/v1
