# ─────────────────────────────────────────────
#  MeetStream - Microsoft Teams Signed-In Bots setup
# ─────────────────────────────────────────────

# Required (not needed for --dry-run). Your MeetStream API key (https://app.meetstream.ai).
# Sent as `Authorization: Token <key>` - the literal word "Token", not "Bearer".
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# Optional. Override the API base URL (defaults to https://api.meetstream.ai/api/v1).
# MEETSTREAM_BASE_URL=https://api.meetstream.ai/api/v1


# ── Login domain (node index.js register-domain) ───────────────────────────────

# The part after the @ in your bot accounts' sign-in emails.
# Also used as teams.teams_login_domain when sending a bot.
TEAMS_LOGIN_DOMAIN=bots.yourcompany.com

# Optional label for the domain entry.
TEAMS_DOMAIN_NAME=Acme Teams bots


# ── Bot accounts (node index.js add-accounts) ──────────────────────────────────
# One Microsoft 365 user per bot. One account runs ONE bot at a time, so list
# as many accounts as you want concurrent signed-in bots.
#
# TEAMS_BOT_PASSWORD_<n> is the password for the n-th email in TEAMS_BOT_ACCOUNTS
# (1-based). Leave one unset to be prompted for it with echo off.
# Keep .env out of git. Passwords are never printed by this CLI.

TEAMS_BOT_ACCOUNTS=bot1@bots.yourcompany.com,bot2@bots.yourcompany.com
TEAMS_BOT_PASSWORD_1=replace_with_bot1_password
TEAMS_BOT_PASSWORD_2=replace_with_bot2_password

# For rotate-password only. Leave unset to be prompted (recommended).
# TEAMS_NEW_PASSWORD=


# ── Sending a signed-in bot (node index.js verify / create-bot) ────────────────

# A Microsoft 365 work or school Teams meeting (teams.microsoft.com).
# Teams for personal use (teams.live.com) is not supported.
MEETING_LINK=https://teams.microsoft.com/l/meetup-join/your-meeting-link

# Optional. Pin one account. Must be registered under TEAMS_LOGIN_DOMAIN.
# Omit to let MeetStream pick any free account.
# SIGN_IN_EMAIL=bot1@bots.yourcompany.com

# Optional, only meaningful with SIGN_IN_EMAIL. The API default is true:
#   true  = fail (409) if that account is busy or deactivated
#   false = fall back to any free account in the domain
# STRICT_EMAIL=false

# Optional. Only shown if the bot ever joins as a guest. A signed-in Teams bot
# uses the Microsoft account's own display name and picture instead.
# BOT_NAME=MeetStream Notetaker

# Record video as well as audio.
VIDEO_REQUIRED=false

# Seconds the bot waits in the lobby before giving up. Teams range: 60-1800.
# WAITING_ROOM_TIMEOUT=600

# Optional per-bot webhook URL for lifecycle events.
# CALLBACK_URL=https://your-app.example.com/meetstream/webhook
