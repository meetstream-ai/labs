# ─────────────────────────────────────────────────────────────
#  MeetStream Labs: Interactive Meeting Agent
#  Copy this file to .env and fill it in.
# ─────────────────────────────────────────────────────────────

# Required. MeetStream dashboard -> API Keys.
# https://app.meetstream.ai
MEETSTREAM_API_KEY=

# Required. The meeting the bot should join (Zoom, Google Meet or Microsoft Teams link).
MEETING_LINK=

# Recording defaults: audio only. `video_required: false` is sent explicitly,
# because the REST API treats an omitted `video_required` as true. There is no
# video env var here; if you enable video in code, also send
# `recording_config.video_layout: "speaker_view"` (the API default is
# `grid_view`). `video_separate_streams` is never set implicitly.

# ─────────────────────────────────────────────────────────────
#  Public URL: pick ONE of the two
#  The bot dials OUT to both your control socket and your audio socket,
#  so they must be reachable from the public internet over wss://
# ─────────────────────────────────────────────────────────────

# Option A: you already have a public HTTPS endpoint pointing at this process.
# PUBLIC_URL=https://agent.example.com

# Option B: let the template open an ngrok tunnel for you (free account is fine).
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# ─────────────────────────────────────────────────────────────
#  Agent behaviour
# ─────────────────────────────────────────────────────────────

# Phrase that triggers the stub brain in src/brain.js
# WAKE_WORD=hey bot

# Optional spoken reply, played through the bot's microphone with sendaudio.
# Must be raw PCM16 little-endian, 48000 Hz, mono (.pcm) or a WAV in that format.
#   ffmpeg -i reply.mp3 -f s16le -acodec pcm_s16le -ar 48000 -ac 1 reply.pcm
# Leave unset to reply in chat only.
# RESPONSE_AUDIO_FILE=./reply.pcm

# Stop the bot talking when a human starts speaking. Default true.
# Note: only Google Meet actually clears the bot's audio queue.
# BARGE_IN=true

# Turn detection tuning. RMS above the threshold counts as speech; a gap of
# SILENCE_MS ends the turn.
# RMS_THRESHOLD=500
# SILENCE_MS=900

# ─────────────────────────────────────────────────────────────
#  Optional
# ─────────────────────────────────────────────────────────────

# Local port for the HTTP + WebSocket server (default 3000)
# PORT=3000

# Display name of the bot in the participant list
# BOT_NAME=MeetStream Labs Agent

# Only change this if you are pointing at a non-production API.
# MEETSTREAM_BASE_URL=https://api.meetstream.ai/api/v1

# Set to any value to disable ANSI colour in the log output.
# NO_COLOR=1

# Only needed once you replace the stub brain with a real model call.
# ANTHROPIC_API_KEY=
