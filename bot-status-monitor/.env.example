# ---------------------------------------------
#  bot-status-monitor
# ---------------------------------------------

# Required (except for `node index.js --explain`).
# Your MeetStream API key from https://app.meetstream.ai
MEETSTREAM_API_KEY=

# The bot to watch. You can also pass it as an argument:
#   node index.js bot_abc123
BOT_ID=

# Only used when no bot id is given: the template creates a bot for this
# meeting and then monitors it (Zoom, Google Meet or Microsoft Teams link).
# MEETING_LINK=https://meet.google.com/xxx-xxxx-xxx

# Optional. Display name used when the template creates a bot.
# BOT_NAME=Status Monitor Bot

# Optional. Milliseconds between status polls.
# POLL_INTERVAL_MS=3000

# Optional. Poll budget before the monitor gives up.
# 400 polls at 3s is roughly 20 minutes.
# MAX_POLLS=400

# Optional. Only change this if you are pointing at a non-production API.
# MEETSTREAM_API_BASE_URL=https://api.meetstream.ai/api/v1

# Recording defaults: audio only. `video_required: false` is sent explicitly,
# because the REST API treats an omitted `video_required` as true. There is no
# video env var here; if you enable video in code, also send
# `recording_config.video_layout: "speaker_view"` (the API default is
# `grid_view`). `video_separate_streams` is never set implicitly.

