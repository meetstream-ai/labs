# ─────────────────────────────────────────────────────────────
#  MeetStream
# ─────────────────────────────────────────────────────────────

# Required. Create one at https://app.meetstream.ai under API Keys.
# Sent as `Authorization: Token <key>` - the literal word Token, not Bearer.
MEETSTREAM_API_KEY=

# Live mode. The meeting the bot should join (Zoom, Google Meet or Microsoft Teams).
# You can also pass it as: node index.js --meeting "<url>"
MEETING_LINK=

# Replay mode. Set one of these (or pass --bot / --transcript) to skip the bot
# and webhook and run against a meeting that already finished.
# BOT_ID=
# TRANSCRIPT_ID=

# Display name the bot shows in the meeting.
# BOT_NAME=MeetStream Labs Bot

# Post-call transcription provider:
#   deepgram | assemblyai | sarvam | jigsawstack | meetstream
# `deepgram` is configured with diarize: true, which gives cleaner per-speaker
# attribution and therefore better talk-time numbers. The code default is meetstream.
# Never a *_streaming provider - those never produce a post-call transcript.
TRANSCRIPT_PROVIDER=deepgram
# TRANSCRIPT_LANGUAGE=en

# How long MeetStream keeps the media. Unset means the API default of 720 hours (30 days).
# RETENTION_HOURS=720

# Recording defaults: this template is audio only. It sends
# `video_required: false` explicitly, because the REST API treats an omitted
# `video_required` as true. There is no video env var here; if you enable video
# in code it sends `recording_config.video_layout: "speaker_view"`, and
# per-participant video (`video_separate_streams`) is never set implicitly.

# ─────────────────────────────────────────────────────────────
#  Webhook (live mode only)
# ─────────────────────────────────────────────────────────────

# Public HTTPS base URL MeetStream can POST to. callback_url becomes ${PUBLIC_BASE_URL}/webhook.
# Dev: `ngrok http 3000` or `cloudflared tunnel --url http://localhost:3000`
PUBLIC_BASE_URL=
# PORT=3000

# Cap and interval for polling get_transcript while it answers HTTP 202.
# TRANSCRIPT_POLL_ATTEMPTS=20
# TRANSCRIPT_POLL_INTERVAL_MS=5000

# ─────────────────────────────────────────────────────────────
#  LLM - REQUIRED for this template
# ─────────────────────────────────────────────────────────────

# Set OPENAI_API_KEY or ANTHROPIC_API_KEY. LLM_PROVIDER picks between them
# when both are set; unset uses whichever key is present.
# LLM_PROVIDER=openai

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Transcript characters sent to the LLM, split across the sentiment sections.
# LLM_MAX_TRANSCRIPT_CHARS=60000
# LLM_MAX_TOKENS=3000

# How many chronological sections to score sentiment across.
# SENTIMENT_BUCKETS=3

# ─────────────────────────────────────────────────────────────
#  Output
# ─────────────────────────────────────────────────────────────

# Writes insights-<transcript_id>.json and .md here.
# OUTPUT_DIR=output

# Also print the report to stdout.
# PRINT_REPORT=true

# Only change this if you are pointing at a non-production API.
# MEETSTREAM_BASE_URL=https://api.meetstream.ai/api/v1
