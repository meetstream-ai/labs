# === Required: MeetStream ===

# Your MeetStream API key. Sent as `Authorization: Token <key>`.
# Get one at https://app.meetstream.ai
MEETSTREAM_API_KEY=your_api_key_here

# === Required: your bucket (the storage config) ===
#
# These five values become the StorageConfigRequest body sent to
# PUT /admin/configs?config_type=storage. `provider` is always "aws" because
# that is the only value the API accepts.

# The bucket MeetStream writes bot media into. You own this bucket.
S3_BUCKET=my-company-meeting-recordings

# The bucket's region. A mismatch fails validation.
S3_REGION=us-west-2

# The IAM access key pair MeetStream uses to write into your bucket.
#
# WARNING: these are real cloud credentials and they are stored on your
# MeetStream account. Scope them to nothing but this bucket and this prefix.
# See the IAM policy in the README. Rotate them like any other shared key.
S3_ACCESS_KEY_ID=your_access_key_id_here
S3_SECRET_KEY=your_secret_access_key_here

# === Optional: storage config tuning ===

# read_write  MeetStream's own fetch endpoints keep serving media out of your
#             bucket. This is the API default.
# write_only  MeetStream writes but never reads back. Its fetch endpoints then
#             return 403 for media in your bucket, so your bucket is the only
#             way to get the files.
S3_ACCESS_MODE=

# Base key prefix. The API defaults to "meetstream". Objects are keyed
# {prefix}/{bot_id}_<file>. No leading or trailing slashes, no ".." segments.
S3_PREFIX=

# Per-artifact-category prefix overrides. Leave blank to keep everything under
# the base prefix above.
S3_PREFIX_AUDIO=
S3_PREFIX_VIDEO=
S3_PREFIX_TRANSCRIPT=
S3_PREFIX_METADATA=

# For S3-compatible stores (MinIO, Cloudflare R2). Omit for real AWS S3.
# This is sent to MeetStream as `endpoint_url`.
S3_ENDPOINT_URL=

# Local-only. Most S3-compatible stores need path-style addressing for the
# bucket checks this template runs from your machine.
S3_FORCE_PATH_STYLE=false

# === Required for `record` only ===

# The meeting the test bot should join (Google Meet, Zoom, or Teams link).
MEETING_LINK=https://meet.google.com/abc-defg-hij

# === Optional: `record` behaviour ===

# Display name the bot uses inside the meeting.
BOT_NAME=MeetStream BYOB Recorder

# Record video as well as audio.
VIDEO_REQUIRED=true

# Seconds the bot waits after everyone else leaves before it leaves too.
EVERYONE_LEFT_TIMEOUT=60

# Public HTTPS base URL MeetStream can reach, so lifecycle events arrive as
# webhooks instead of being polled for. The bot's callback_url becomes
# "<PUBLIC_WEBHOOK_URL>/webhook". Get one locally with: ngrok http 3000
PUBLIC_WEBHOOK_URL=

# Local port the webhook server listens on.
PORT=3000

# Polling caps: used for the bot status loop and the bucket listing loop.
POLL_MAX_ATTEMPTS=80
POLL_INTERVAL_MS=15000

# === HTTP behaviour ===
REQUEST_TIMEOUT_MS=30000
MAX_RETRIES=4

# Only change this if you are pointing at a non-production API.
# MEETSTREAM_API_BASE_URL=https://api.meetstream.ai/api/v1

# One of: silent, error, warn, info, debug
LOG_LEVEL=info
