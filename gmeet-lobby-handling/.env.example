# ─────────────────────────────────────────────
#  MeetStream - Google Meet lobby handling
# ─────────────────────────────────────────────

# Required. Your MeetStream API key (https://app.meetstream.ai).
# Sent as `Authorization: Token <key>` - the literal word "Token", not "Bearer".
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# Optional. Override the API base URL (defaults to https://api.meetstream.ai/api/v1).
# MEETSTREAM_BASE_URL=https://api.meetstream.ai/api/v1

# Required. The Google Meet link to join.
MEETING_LINK=https://meet.google.com/xxx-xxxx-xxx

# Display name shown in the meeting (anonymous bots only - a signed-in bot shows
# the Google account's own name).
BOT_NAME=MeetStream Notetaker

# Record video as well as audio.
VIDEO_REQUIRED=false


# ── Webhook receiver ───────────────────────────────────────────────────────────

# Local port for the express server.
PORT=3000

# Path the receiver listens on, and that MeetStream calls back.
WEBHOOK_PATH=/webhook

# Required. The public https base URL that reaches this server, e.g. your ngrok
# or Cloudflare tunnel origin. callback_url is built as PUBLIC_WEBHOOK_URL + WEBHOOK_PATH.
PUBLIC_WEBHOOK_URL=https://your-tunnel.ngrok-free.app

# Optional. HMAC secret for signature verification.
# NOTE: per-bot callback_url deliveries are NOT signed - signatures only apply to
# workspace webhook endpoints created in the dashboard. Leave this unset unless
# you are receiving on such an endpoint.
# WEBHOOK_SECRET=your_workspace_endpoint_secret

# Optional. Alerts are POSTed here as JSON in addition to being logged.
# NOTIFY_WEBHOOK_URL=https://your-app.example.com/alerts


# ── Lobby behaviour ────────────────────────────────────────────────────────────

# How long the bot waits to be admitted before leaving, in seconds.
# Google Meet range: 60-600 (default 600). Out of range returns HTTP 400.
WAITING_ROOM_TIMEOUT=300

# Alert a human if the bot is still in the lobby after this many seconds.
# Set to 0 to disable the nudge.
LOBBY_ALERT_SECONDS=60

# How many times to send a bot in total when it times out in the lobby
# (NotAllowed). A host-initiated Denied is never retried.
MAX_JOIN_ATTEMPTS=2

# Seconds to wait before re-sending a bot after a lobby timeout.
RETRY_DELAY_SECONDS=30

# Seconds added to waiting_room_timeout on each retry (capped at 600).
RETRY_TIMEOUT_ESCALATION=120


# ── Signed-in bot (the real fix for lobby friction) ────────────────────────────
# Set these to join as an authenticated Google account instead of a guest.
# Requires the one-time setup in the google-signed-in-bots-setup template.
# Add SIGN_IN_EMAIL to the calendar invite and the bot bypasses the lobby.

# GOOGLE_LOGIN_DOMAIN=yourdomain.com
# SIGN_IN_EMAIL=bot@yourdomain.com
# STRICT_EMAIL=false
