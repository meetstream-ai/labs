# ---------------------------------------------
#  zoom-oauth-connections
# ---------------------------------------------

# Required. Your MeetStream API key from https://app.meetstream.ai
# Sent as `Authorization: Token <key>`.
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# Required. The redirect URL Zoom sends the end user back to after they approve.
#
# This value must match the redirect URL registered on your Zoom Marketplace app
# byte-for-byte: same scheme, host, port, path, no trailing slash difference.
# Zoom requires HTTPS, so for local development run a tunnel and register the
# tunnel URL on the Zoom app:
#
#   ngrok http 3000
#   -> https://your-subdomain.ngrok-free.app/zoom/callback
#
ZOOM_REDIRECT_URI=https://your-subdomain.ngrok-free.app/zoom/callback

# Optional. Local port the callback listener binds to. The tunnel forwards here.
# If ZOOM_REDIRECT_URI already points at localhost, its port is used instead.
PORT=3000

# Optional. Only change this if you are pointing at a non-production API.
# MEETSTREAM_API_BASE_URL=https://api.meetstream.ai/api/v1
