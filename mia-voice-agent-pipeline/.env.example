# Copy this file to .env and fill in the values. Never commit .env.

# Required. Get a key at https://app.meetstream.ai
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# Required. Full Google Meet, Zoom, or Microsoft Teams link.
MEETING_LINK=https://meet.google.com/abc-defg-hij

# Optional. Reuse an agent saved by an earlier run instead of creating a new one.
# MEETSTREAM_AGENT_CONFIG_ID=

# ---------------------------------------------------------------------------
# Pipeline layer 1: speech to text
# Providers: deepgram, assemblyai, sarvam, jigsawstack, meetstream
# ---------------------------------------------------------------------------
MIA_TRANSCRIBER_PROVIDER=deepgram
MIA_TRANSCRIBER_MODEL=nova-3
MIA_TRANSCRIBER_LANGUAGE=en

# ---------------------------------------------------------------------------
# Pipeline layer 2: the LLM that decides what to say
# The provider integration must be enabled in your MeetStream dashboard.
# ---------------------------------------------------------------------------
MIA_MODEL_PROVIDER=openai
MIA_MODEL=gpt-4.1
MIA_SYSTEM_PROMPT=You are MIA, a spoken assistant in a live meeting. Answer in one or two short sentences.

# ---------------------------------------------------------------------------
# Pipeline layer 3: text to speech (the voice heard in the meeting)
# ---------------------------------------------------------------------------
MIA_VOICE_PROVIDER=openai
MIA_VOICE_ID=nova

# Agent presentation
MIA_AGENT_NAME=Pipeline Voice Assistant
MIA_FIRST_MESSAGE=Hi, I am MIA. Ask me anything while the meeting runs.

# Bot settings
BOT_NAME=MIA Voice Agent

# Optional. Public HTTPS endpoint that receives per-bot lifecycle webhooks.
# CALLBACK_URL=https://your-domain.example/webhooks/meetstream

# Optional. Delete the agent config when the program exits (default false).
# DELETE_AGENT_ON_EXIT=false

# Optional. How often to poll bot status, in seconds (default 10).
# POLL_INTERVAL_SECONDS=10

# Optional. Override only if MeetStream gave you a different base URL.
# MEETSTREAM_BASE_URL=https://api.meetstream.ai/api/v1
