# ---------------------------------------------------------------------------
# MeetStream webhook-handler-complete
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Your MeetStream API key. Only needed for --create-bot; the receiver and
# --simulate run without it. Get one at https://app.meetstream.ai
MEETSTREAM_API_KEY=

# API base URL. Change only if you were given a different host.
# MEETSTREAM_BASE_URL=https://api.meetstream.ai/api/v1

# Local port for the webhook server.
# PORT=3000

# Path the receiver listens on. Your callback_url must end with this exact path.
# WEBHOOK_PATH=/webhook

# --create-bot only. Public HTTPS origin that MeetStream can reach, with NO
# trailing slash. callback_url is built as PUBLIC_URL + WEBHOOK_PATH.
# MeetStream will not deliver to http:// or to localhost.
# Need one for local dev? See the webhook-local-tunnel template.
PUBLIC_URL=

# --create-bot only: the meeting the bot should join (Zoom / Google Meet / Teams).
MEETING_LINK=

# Display name the bot uses in the meeting.
# BOT_NAME=Webhook Reference Bot

# Record video as well as audio. "true" or "false".
# Video is OFF by default: this bot records audio only unless you ask for video.
# `video_required: false` is sent explicitly, because the REST API treats an
# omitted `video_required` as true.
# VIDEO_REQUIRED=false

# Only read when VIDEO_REQUIRED is true. "speaker_view" or "grid_view". The API
# default is grid_view, so speaker view is sent explicitly. Use grid_view only
# when you want the composited mosaic of everyone.
# VIDEO_LAYOUT=speaker_view

# Transcription provider. This decides whether a post-call transcript exists.
# Every bot's webhook stream ends at bot.done either way.
#   Post-call (transcription.processed / transcription.failed, then bot.done):
#     deepgram | assemblyai | sarvam | jigsawstack | meetstream
#   Streaming-only (no post-call transcript events, still ends at bot.done):
#     deepgram_streaming | assemblyai_streaming | jigsawstack_streaming
#     | meetstream_streaming | meeting_captions
# TRANSCRIPT_PROVIDER=deepgram

# Set to any value to disable ANSI colour in the log output.
# NO_COLOR=1
