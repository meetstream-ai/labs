# ---------------------------------------------------------------------------
# MeetStream webhook-handler-complete
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Your MeetStream API key. Only needed for --create-bot; the receiver and
# --simulate run without it. Get one at https://app.meetstream.ai
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# API base URL. Change only if you were given a different host.
MEETSTREAM_BASE_URL=https://api.meetstream.ai/api/v1

# Local port for the webhook server.
PORT=3000

# Path the receiver listens on. Your callback_url must end with this exact path.
WEBHOOK_PATH=/webhook

# Public HTTPS origin that MeetStream can reach, with NO trailing slash.
# callback_url is built as PUBLIC_URL + WEBHOOK_PATH.
# MeetStream will not deliver to http:// or to localhost.
# Need one for local dev? See the webhook-local-tunnel template.
PUBLIC_URL=https://your-tunnel-subdomain.ngrok-free.app

# --create-bot only: the meeting the bot should join (Zoom / Google Meet / Teams).
MEETING_LINK=https://meet.google.com/xxx-xxxx-xxx

# Display name the bot uses in the meeting.
BOT_NAME=Webhook Reference Bot

# Record video as well as audio. "true" or "false".
VIDEO_REQUIRED=false

# Transcription provider. This decides where the webhook stream ENDS.
#   Post-call (ends at bot.done):
#     deepgram | assemblyai | sarvam | jigsawstack | meetstream
#   Streaming-only (ends at audio.processed, NEVER emits bot.done):
#     deepgram_streaming | assemblyai_streaming | jigsawstack_streaming
#     | meetstream_streaming | meeting_captions
TRANSCRIPT_PROVIDER=deepgram
