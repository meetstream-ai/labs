# ---------------------------------------------
#  scheduled-bot-join-at
# ---------------------------------------------

# Required. Your MeetStream API key from https://app.meetstream.ai
MEETSTREAM_API_KEY=your_meetstream_api_key_here

# Required for `create`. The meeting the bot should join at join_at.
MEETING_LINK=https://meet.google.com/xxx-xxxx-xxx

# Optional. Default target for `reschedule` and `cancel`.
# You can also pass it as an argument:
#   node index.js cancel bot_abc123
BOT_ID=

# Optional. Display name the bot uses inside the meeting.
BOT_NAME=Scheduled Bot

# Optional. "true" records video as well as audio.
VIDEO_REQUIRED=false

# Optional. Only change this if you are pointing at a non-production API.
# MEETSTREAM_API_BASE_URL=https://api.meetstream.ai/api/v1
